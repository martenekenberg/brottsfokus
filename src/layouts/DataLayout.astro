---
// Layout for the table pages: site menu, breadcrumb, content, footer.
import Base from './Base.astro';
import ChapterNav from '../components/ChapterNav.astro';
import Footer from '../components/Footer.astro';
import { site, absoluteUrl } from '../lib/site';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  /** Breadcrumb trail after the main page, ending with this page. */
  crumbs: Crumb[];
  citations?: string[];
  jsonLdNodes?: Record<string, unknown>[];
}

const { title, description, path, crumbs, citations = [], jsonLdNodes = [] } = Astro.props;
const trail: Crumb[] = [{ name: site.name, path: '/' }, ...crumbs];
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: absoluteUrl(c.path) })),
};
---

<Base title={title} description={description} path={path} citations={citations} jsonLdNodes={[breadcrumbLd, ...jsonLdNodes]}>
  <div class="wrap">
    <div id="top"></div>
    <ChapterNav home={false} />
    <nav aria-label="Du är här" class="crumbs">
      <ol>
        {
          trail.map((c, i) =>
            i < trail.length - 1 ? (
              <li>
                <a href={c.path}>{c.name}</a>
              </li>
            ) : (
              <li aria-current="page">{c.name}</li>
            ),
          )
        }
      </ol>
    </nav>
    <main class="data-main">
      <slot />
    </main>
    <Footer />
  </div>
</Base>

<style>
  #top {
    height: 24px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin: 0;
    padding: 16px 0 0;
    list-style: none;
    font-size: 13px;
    color: var(--text-muted);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 8px;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
  }
  .crumbs li[aria-current] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .data-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px 0 64px;
  }
  .data-main :global(h1) {
    margin: 0;
    max-width: 860px;
    font-family: var(--font-serif);
    font-size: 44px;
    line-height: 1.1;
    font-weight: 500;
  }
  .data-main :global(.lead) {
    max-width: 680px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-body);
  }
  .data-main :global(h2) {
    margin: 16px 0 0;
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.2;
    font-weight: 500;
  }
  .data-main :global(.note) {
    max-width: 820px;
    background: var(--panel);
    padding: 16px 20px;
    font-size: 14px;
    line-height: 1.55;
  }
  .data-main :global(.body) {
    max-width: 680px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-body);
  }
  .data-main :global(.source) {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .data-main :global(.source a) {
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .data-main :global(h1) {
      font-size: 30px;
      line-height: 1.15;
    }
    .data-main :global(.lead) {
      font-size: 18px;
    }
    .data-main :global(h2) {
      font-size: 22px;
    }
  }
</style>
