---
import DataLayout from '../../layouts/DataLayout.astro';
import { chapter } from '../../lib/chapters';
import { tablePages, tablesIndexPath } from '../../lib/dataPages';
import { site } from '../../lib/site';
import { dataDate } from '../../lib/dataDates';

const title = `Tabeller och CSV-filer | ${site.name}`;
const description = 'Siffrorna bakom diagrammen på Brottsfokus som tabeller och CSV-filer, med källa och begränsningar för varje tabell.';
---

<DataLayout
  title={title}
  description={description}
  path={tablesIndexPath}
  updated={dataDate()}
  crumbs={[{ name: 'Tabeller', path: tablesIndexPath }]}
>
  <p class="kicker">Tabeller</p>
  <h1>Tabeller och CSV-filer</h1>
  <p class="lead">
    Siffrorna bakom diagrammen, som tabeller och som filer att ladda ner. Varje tabell har sin källa och en ruta om vad
    siffrorna inte visar.
  </p>
  <ul class="list">
    {
      tablePages.map((p) => {
        const c = chapter(p.chapterId);
        return (
          <li>
            <span class="num">{c.num}</span>
            <a href={p.path}>{p.name}</a>
            <a class="csv" href={p.csvPath} download>CSV</a>
          </li>
        );
      })
    }
  </ul>
</DataLayout>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .list li {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .list a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 16px;
    font-weight: 500;
  }
  .num {
    color: var(--second);
    font-size: 14px;
    font-weight: 700;
  }
  .list .csv {
    margin-left: auto;
    font-size: 13px;
    font-weight: 400;
  }
</style>
