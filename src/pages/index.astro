---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ChapterNav from '../components/ChapterNav.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Chapter from '../components/Chapter.astro';
import Legend from '../components/Legend.astro';
import LineChart from '../components/charts/LineChart.astro';
import SuspectsOverTime from '../components/kap1/SuspectsOverTime.astro';
import { allGroupsFell, buildKap1Data } from '../lib/chapters/kap1';
import OriginDots from '../components/kap2/OriginDots.astro';
import { buildKap2Data, smallestGroup } from '../lib/chapters/kap2';
import RapeStudies from '../components/kap4/RapeStudies.astro';
import { buildKap4 } from '../lib/chapters/kap4';
import OlderStudies from '../components/kap5/OlderStudies.astro';
import { buildKap5 } from '../lib/chapters/kap5';
import Method from '../components/Method.astro';
import Footer from '../components/Footer.astro';
import About from '../components/About.astro';
import { site, monthYear } from '../lib/site';

import { loadOrigin, loadPopulation, loadPrison, loadRapeStudies, loadSuspectsByBackground, loadBra2005, loadTableB6 } from '../lib/data';
import { foreignCitizenSharePct, prisonSeries, yearsWithValues } from '../lib/calc';
import { formatNumber } from '../lib/format';
import type { LineChartSpec } from '../lib/charts/line';

const C = {
  ink: '#121212',
  muted: '#5C5C5C',
  focus: '#1D4E89',
  second: '#C2410C',
  population: '#8A8A8A',
};

// ---------- Chapter 3: prison and citizenship ----------
const prison = loadPrison();
const population = loadPopulation();

const popShare = new Map(population.map((r) => [r.year, foreignCitizenSharePct(r)]));
const newAll = prisonSeries(prison, 'nyintagna', 'totalt');
const newMen = prisonSeries(prison, 'nyintagna', 'man');
const newWomen = prisonSeries(prison, 'nyintagna', 'kvinnor');
const onOct1 = prisonSeries(prison, '1okt', 'totalt');

// The period comes from the data file, so a new year shows up without code changes.
const firstYear = Math.min(...prison.map((r) => r.year));
const lastYear = Math.max(...prison.map((r) => r.year));
const prisonYears = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const byYear = (m: Map<number, number | null>) => prisonYears.map((y) => m.get(y) ?? null);

const newAllLast = newAll.get(lastYear);
const popShareLast = popShare.get(lastYear);
if (newAllLast == null || popShareLast == null) throw new Error(`Missing ${lastYear} values for chapter 3`);

// The headline says the share has fallen since its highest year. Stop the build if the data no longer says so.
const peakYear = prisonYears.reduce((best, y) => ((newAll.get(y) ?? -1) > (newAll.get(best) ?? -1) ? y : best), firstYear);
const newAllPeak = newAll.get(peakYear) as number;
if (!(newAllLast < newAllPeak) || peakYear === lastYear) throw new Error('Chapter 3 headline no longer matches the data');

// Men and women share one colour, so each line is named where it starts.
const startLabel = (m: Map<number, number | null>, text: string) => {
  const span = yearsWithValues(m);
  return span ? [{ year: span.first, text }] : [];
};
const prisonMax = Math.max(...[newAll, newMen, newWomen, onOct1].flatMap((m) => [...m.values()].map((v) => v ?? 0)));

const prisonSpec: LineChartSpec = {
  years: prisonYears,
  yMax: Math.max(40, Math.ceil(prisonMax / 10) * 10),
  yTickStep: 10,
  yFormat: 'pct',
  ariaLabel:
    'Linjediagram. Andel utan svenskt medborgarskap bland nyintagna i fängelse, totalt och för män och kvinnor, ' +
    `och bland intagna den 1 oktober, ${firstYear} till ${lastYear}, jämfört med andelen utländska medborgare i befolkningen. ` +
    `År ${lastYear} var andelen ${formatNumber(newAllLast)} procent bland nyintagna och ` +
    `${formatNumber(popShareLast, 1)} procent i befolkningen. År som Brå inte anger saknas.`,
  series: [
    {
      id: 'ny-alla',
      label: 'Nyintagna, alla',
      endLabel: 'nyintagna',
      endLabelShort: 'alla',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 3,
      dotRadius: 3.5,
      values: byYear(newAll),
      annotate: [peakYear],
      format: 'pct',
    },
    {
      id: 'ny-man',
      label: 'Nyintagna män',
      endLabel: 'män',
      endLabelShort: 'män',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 1.5,
      dotRadius: 2.5,
      values: byYear(newMen),
      pointLabels: startLabel(newMen, 'män'),
      format: 'pct',
    },
    {
      id: 'ny-kvinnor',
      label: 'Nyintagna kvinnor',
      endLabel: 'kvinnor',
      endLabelShort: 'kvinnor',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 1.5,
      dotRadius: 2.5,
      values: byYear(newWomen),
      pointLabels: startLabel(newWomen, 'kvinnor'),
      format: 'pct',
    },
    {
      id: 'okt',
      label: 'Intagna den 1 oktober',
      endLabel: '1 oktober',
      endLabelShort: '1 okt',
      color: C.second,
      textColor: C.second,
      strokeWidth: 2.5,
      dotRadius: 3.5,
      values: byYear(onOct1),
      format: 'pct',
    },
    {
      id: 'bef',
      label: 'Utländska medborgare i befolkningen',
      endLabel: 'befolkningen',
      endLabelShort: '',
      color: C.population,
      textColor: C.muted,
      strokeWidth: 2,
      dashed: true,
      dotRadius: 2.5,
      values: byYear(popShare),
      format: 'pct1',
    },
  ],
};

// Brå prison reports, one link per report, in year order.
const prisonSources = [...new Map(prison.map((r) => [r.sourceUrl, r.source])).entries()]
  .map(([url, label]) => ({ url, label }))
  .sort((a, b) => a.label.localeCompare(b.label, 'sv'));
const shortReportName = (label: string) => label.replace(/^Brå /, '');

// ---------- Key figures ----------
const suspects = loadSuspectsByBackground();
const kap1Data = buildKap1Data(suspects);
// Chapter 2 uses the same crime list, so its menu is indented the same way.
const depthByOrder = new Map(suspects.map((r) => [r.crimeOrder, r.depth]));
const tableB6 = loadTableB6();
const kap2Data = buildKap2Data(loadOrigin(), depthByOrder, tableB6);
const kap4 = buildKap4(loadRapeStudies(), population);
const kap5 = buildKap5(loadBra2005());

// Headline checks: stop the build if a headline no longer matches the data.
const kap1First = kap1Data.years[0];
const kap1Last = kap1Data.years[kap1Data.years.length - 1];
if (!allGroupsFell(kap1Data, 'c00')) throw new Error('Chapter 1 headline no longer matches the data');
if (!kap5.foreignBornRiskRose) throw new Error('Chapter 5 headline no longer matches the data');

// Smallest groups in chapter 2, for the note under the chart.
const smallestCountry = smallestGroup(kap2Data, 'land');
const smallestMotherRegion = smallestGroup(kap2Data, 'moder');
if (!smallestCountry || !smallestMotherRegion) throw new Error('Chapter 2: group sizes missing');
// Key figures use Brå's own risk values for 2015–2018 (table B6), as stated in the report.
const b6Risk = (unit: string) => {
  const r = tableB6.find((x) => x.view === 'bakgrund' && x.unit === unit);
  if (!r) throw new Error(`Table B6: ${unit} missing`);
  return r.risk;
};
const riskUtr = b6Risk('Utrikesfödda');
const riskU2 = b6Risk('Inrikesfödda med två utrikesfödda föräldrar');

const keyFigures = [
  {
    value: formatNumber(riskUtr, 1),
    unit: '×',
    text: 'Så mycket vanligare var det för utrikesfödda att registreras som misstänkta för brott än för inrikesfödda med två inrikesfödda föräldrar.',
    source: 'Brå rapport 2021:9, 2015–2018',
  },
  {
    value: formatNumber(riskU2, 1),
    unit: '×',
    text: 'För inrikesfödda med två utrikesfödda föräldrar var det drygt tre gånger så vanligt.',
    source: 'Brå rapport 2021:9, 2015–2018',
  },
  {
    value: formatNumber(newAllLast),
    unit: ' %',
    text: `av de nyintagna i fängelse ${lastYear} saknade svenskt medborgarskap. I befolkningen var andelen ${formatNumber(popShareLast, 1)} procent.`,
    source: `Brå ${lastYear}; SCB`,
  },
];
---

<Base
  title={site.title}
  description={site.description}
>
  <div class="wrap">
    <Masthead updated={monthYear(site.updated)} sources="Brå, SCB, Lunds universitet" />
    <ChapterNav />
    <KeyFigures figures={keyFigures} />

    <main>
      <Chapter
        id="kap1"
        title={`Sett till alla brott minskade andelen misstänkta i alla fyra grupper mellan ${kap1First} och ${kap1Last}`}
      >
        <p slot="intro">
          Andelen av befolkningen, 15 år och äldre, som misstänktes för minst ett brott under året. Grupperna bygger
          på var personen och personens föräldrar är födda.
        </p>
        <SuspectsOverTime data={kap1Data} />
        <Fragment slot="note">
          Inte justerat för ålder eller kön. Grupperna med utländsk bakgrund har fler unga, som oftare misstänks. Med
          hänsyn till ålder, kön, inkomst, utbildning och kommuntyp minskar skillnaderna, men de finns kvar. Mycket
          ovanliga brott kan svänga mellan åren eftersom Brå avrundar till två decimaler. Det märks mest i jämförelsen
          med två inrikesfödda föräldrar, som räknas från de avrundade talen. Rubriken gäller brott totalt, för enskilda
          brottstyper ser utvecklingen olika ut. Övergrepp i rättssak saknas 2007–2008.
        </Fragment>
        <Fragment slot="source">
          Källa: Brå rapport 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund.
          Folkbokförda personer 15 år och äldre.
        </Fragment>
      </Chapter>

      <Chapter
        id="kap2"
        title="Överrisken var störst bland födda i Afrika och Centralasien och nära 1 bland födda i Norden, Västeuropa och Östasien"
      >
        <p slot="intro">
          Hur många gånger vanligare det var att misstänkas för brott någon gång 2015–2018 än för inrikesfödda med två
          inrikesfödda föräldrar. Utrikesfödda efter födelseområde eller födelseland, och inrikesfödda med två
          utrikesfödda föräldrar efter moderns födelseområde.
        </p>
        <OriginDots data={kap2Data} />
        <Fragment slot="note">
          Orange punkt visar Brås beräkning om gruppen haft samma ålder, kön, inkomst och utbildning som
          jämförelsegruppen, inte en faktisk andel. Alla som misstänktes någon gång under fyra år räknas, därför är talen
          högre än i kapitel 1. Vissa grupper är små: det minsta födelselandet har {formatNumber(smallestCountry.n)}
          personer och den minsta gruppen efter moderns födelseområde {formatNumber(smallestMotherRegion.n)}.
        </Fragment>
        <Fragment slot="source">
          Källa: <a href="https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund">Brå rapport 2021:9</a>,
          tabellbilaga 1 (andelar av misstänkta och befolkningen: tabell B6). Folkbokförda 15 år och äldre den 31
          december 2014, misstänkta för brott begångna 2015–2018.
        </Fragment>
      </Chapter>

      <Chapter id="kap3" title={`Andelen utan svenskt medborgarskap bland nyintagna har minskat sedan ${peakYear}`}>
        <p slot="intro">
          År {lastYear} saknade {formatNumber(newAllLast)} procent av dem som togs in i fängelse svenskt medborgarskap.
          I hela befolkningen var {formatNumber(popShareLast, 1)} procent utländska medborgare.
        </p>
        <Legend
          slot="legend"
          items={[
            { label: 'Nyintagna under året', color: C.focus, mark: 'line' },
            { label: 'Nyintagna män och kvinnor', color: C.focus, mark: 'line', thin: true },
            { label: 'Intagna den 1 oktober', color: C.second, mark: 'line' },
            { label: 'Utländska medborgare i befolkningen', color: C.population, mark: 'dash' },
          ]}
        />
        <LineChart spec={prisonSpec} />
        <Fragment slot="note">
          Medborgarskap är inte födelseland. Bland fängelsets utländska medborgare finns personer som inte bor i Sverige
          och inte räknas i befolkningen. Punkter saknas för år som Brå inte anger.
        </Fragment>
        <Fragment slot="source">
          Källor: {
            prisonSources.map((s, i) => (
              <>
                <a href={s.url}>{shortReportName(s.label)}</a>
                {i < prisonSources.length - 1 ? ', ' : ''}
              </>
            ))
          }; SCB, befolkningen den 31 december.
        </Fragment>
      </Chapter>

      <Chapter id="kap4" title="Utländsk bakgrund var vanligare bland dömda för våldtäkt än i kontrollgrupp och befolkning">
        <p slot="intro">
          Två registerstudier från Lunds universitet av alla som dömts för våldtäkt eller försök till våldtäkt mot en
          kvinna 18 år eller äldre.
        </p>
        <RapeStudies kap4={kap4} />
        <Fragment slot="note">
          Studierna gäller dömda, inte alla som begår våldtäkt. De dömda är män 15–60 år, medan befolkningens andel
          gäller alla åldrar och båda könen (snitt 2000–2015). Den första studien anmäldes till Överklagandenämnden för
          etikprövning. Det översta stapelparet är uträknat: den senare studien anger andelen inrikesfödda med två
          inrikesfödda föräldrar ({formatNumber(kap4.sv2Convicted, 1)} procent av de dömda och
          {formatNumber(kap4.sv2Controls, 1)} procent av kontrollgruppen), resten är alla övriga, även inrikesfödda med
          en utrikesfödd förälder. I den senare minskade sambandet efter justering för bland annat socioekonomi och tidigare
          brottslighet, men det fanns kvar.
        </Fragment>
        <Fragment slot="source">
          Källor: <a href="https://doi.org/10.1080/20961790.2020.1868681">Khoshnood m.fl. 2021</a>, Forensic Sciences
          Research, tabell 1 och 2 (dömda 2000–2015);
          <a href="https://lup.lub.lu.se/record/d9a9d1f6-f428-4b57-abf2-5e0e9c7b84f5">Khoshnood m.fl. 2026</a>, Journal
          of Interpersonal Violence (dömda och kontrollgrupp 2000–2020); SCB, befolkningen den 31 december.
        </Fragment>
      </Chapter>

      <Chapter id="kap5" title="Överrisken för utrikesfödda ökade mellan 1985–89 och 1997–2001">
        <p slot="intro">
          Överrisk är andelen misstänkta i gruppen delat med andelen bland inrikesfödda med två inrikesfödda
          föräldrar. Standardiserad överrisk tar hänsyn till kön, ålder, utbildning och förvärvsinkomst.
        </p>
        <OlderStudies kap5={kap5} />
        <Fragment slot="note">
          Siffrorna är över 20 år gamla. Standardiserad överrisk finns bara separat för en och två utrikesfödda
          föräldrar: {formatNumber(kap5.standOneParent, 1)} och {formatNumber(kap5.standTwoParents, 1)}. Några brottstyper
          i Brås tabell 11 gick inte att läsa ur PDF-filen och saknas.
        </Fragment>
        <Fragment slot="source">
          Källor: <a href="https://www.bra.se/download/18.cba82f7130f475a2f1800012697/2005_17_brottslighet_bland_personer_fodda_sverige_och_utlandet.pdf">Brå rapport 2005:17</a>,
          tabell 7–11 och bilaga 4 tabell 1. Uppgifterna för 1985–1989 kommer från Brå 1996 och redovisas i tabell 8 i
          Brå 2005:17. Folkbokförda, misstänkta minst en gång under perioden.
        </Fragment>
      </Chapter>

      <Method extraSources={prisonSources} />
      <About />
    </main>

    <Footer />
  </div>
</Base>
