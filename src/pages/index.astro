---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ChapterNav from '../components/ChapterNav.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Chapter from '../components/Chapter.astro';
import Legend from '../components/Legend.astro';
import LineChart from '../components/charts/LineChart.astro';
import SuspectsOverTime from '../components/kap1/SuspectsOverTime.astro';
import { buildKap1Data } from '../lib/chapters/kap1';
import OriginDots from '../components/kap2/OriginDots.astro';
import { buildKap2Data } from '../lib/chapters/kap2';
import RapeStudies from '../components/kap4/RapeStudies.astro';
import { buildKap4 } from '../lib/chapters/kap4';
import OlderStudies from '../components/kap5/OlderStudies.astro';
import { buildKap5 } from '../lib/chapters/kap5';
import Method from '../components/Method.astro';
import Footer from '../components/Footer.astro';

import { loadOrigin, loadPopulation, loadPrison, loadRapeStudies, loadSuspectsByBackground, loadBra2005 } from '../lib/data';
import { foreignCitizenSharePct, prisonSeries, rateRatioVsSv2 } from '../lib/calc';
import { formatNumber } from '../lib/format';
import type { LineChartSpec } from '../lib/charts/line';

const C = {
  ink: '#121212',
  muted: '#5C5C5C',
  focus: '#1D4E89',
  second: '#C2410C',
  population: '#8A8A8A',
};

// ---------- Chapter 3: prison and citizenship ----------
const prison = loadPrison();
const population = loadPopulation();

const prisonYears = Array.from({ length: 2025 - 2014 + 1 }, (_, i) => 2014 + i);
const byYear = (m: Map<number, number | null>) => prisonYears.map((y) => m.get(y) ?? null);

const popShare = new Map(population.map((r) => [r.year, foreignCitizenSharePct(r)]));
const newAll = prisonSeries(prison, 'nyintagna', 'totalt');
const lastYear = 2025;
const newAllLast = newAll.get(lastYear);
const popShareLast = popShare.get(lastYear);
if (newAllLast == null || popShareLast == null) throw new Error('Missing 2025 values for chapter 3');

const prisonSpec: LineChartSpec = {
  years: prisonYears,
  yMax: 40,
  yTickStep: 10,
  yFormat: 'pct',
  ariaLabel:
    'Linjediagram. Andel utan svenskt medborgarskap bland nyintagna i fängelse, totalt och för män och kvinnor, ' +
    'och bland intagna den 1 oktober, 2014 till 2025, jämfört med andelen utländska medborgare i befolkningen. ' +
    `År ${lastYear} var andelen ${formatNumber(newAllLast)} procent bland nyintagna och ` +
    `${formatNumber(popShareLast, 1)} procent i befolkningen. År som Brå inte anger saknas.`,
  series: [
    {
      id: 'ny-alla',
      label: 'Nyintagna, alla',
      endLabel: 'nyintagna',
      endLabelShort: 'alla',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 3,
      dotRadius: 3.5,
      values: byYear(newAll),
      annotate: [2015],
      format: 'pct',
    },
    {
      id: 'ny-man',
      label: 'Nyintagna män',
      endLabel: 'män',
      endLabelShort: 'män',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 1.5,
      dotRadius: 2.5,
      values: byYear(prisonSeries(prison, 'nyintagna', 'man')),
      format: 'pct',
    },
    {
      id: 'ny-kvinnor',
      label: 'Nyintagna kvinnor',
      endLabel: 'kvinnor',
      endLabelShort: 'kvinnor',
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 1.5,
      dotRadius: 2.5,
      values: byYear(prisonSeries(prison, 'nyintagna', 'kvinnor')),
      format: 'pct',
    },
    {
      id: 'okt',
      label: 'Intagna den 1 oktober',
      endLabel: '1 oktober',
      endLabelShort: '1 okt',
      color: C.second,
      textColor: C.second,
      strokeWidth: 2.5,
      dotRadius: 3.5,
      values: byYear(prisonSeries(prison, '1okt', 'totalt')),
      format: 'pct',
    },
    {
      id: 'bef',
      label: 'Utländska medborgare i befolkningen',
      endLabel: 'befolkningen',
      endLabelShort: '',
      color: C.population,
      textColor: C.muted,
      strokeWidth: 2,
      dashed: true,
      dotRadius: 2.5,
      values: byYear(popShare),
      format: 'pct1',
    },
  ],
};

// Brå prison reports, one link per report, in year order.
const prisonSources = [...new Map(prison.map((r) => [r.sourceUrl, r.source])).entries()]
  .map(([url, label]) => ({ url, label }))
  .sort((a, b) => a.label.localeCompare(b.label, 'sv'));
const shortReportName = (label: string) => label.replace(/^Brå /, '');

// ---------- Key figures ----------
const suspects = loadSuspectsByBackground();
const kap1Data = buildKap1Data(suspects);
// Chapter 2 uses the same crime list, so its menu is indented the same way.
const depthByOrder = new Map(suspects.map((r) => [r.crimeOrder, r.depth]));
const kap2Data = buildKap2Data(loadOrigin(), depthByOrder);
const kap4 = buildKap4(loadRapeStudies(), population);
const kap5 = buildKap5(loadBra2005());
const keyYear = 2018;
const ratioUtr = rateRatioVsSv2(suspects, keyYear, 'c00', 'utr');
const ratioU2 = rateRatioVsSv2(suspects, keyYear, 'c00', 'u2');

const keyFigures = [
  {
    value: formatNumber(ratioUtr, 1),
    unit: '×',
    text: 'Så mycket vanligare var det för utrikesfödda att registreras som misstänkta för brott än för inrikesfödda med två inrikesfödda föräldrar.',
    source: `Brå rapport 2021:9, år ${keyYear}`,
  },
  {
    value: formatNumber(Math.floor(ratioU2)),
    unit: '×',
    text: 'För inrikesfödda med två utrikesfödda föräldrar var det drygt tre gånger så vanligt.',
    source: `Brå rapport 2021:9, år ${keyYear}`,
  },
  {
    value: formatNumber(newAllLast),
    unit: ' %',
    text: `av de nyintagna i fängelse ${lastYear} saknade svenskt medborgarskap. I befolkningen var andelen ${formatNumber(popShareLast, 1)} procent.`,
    source: `Brå ${lastYear}; SCB`,
  },
];
---

<Base
  title="Brott och bakgrund"
  description="Officiell statistik och forskning om misstänkta, dömda och intagna i Sverige efter födelseland, föräldrarnas födelseland och medborgarskap, jämfört med befolkningen."
>
  <div class="wrap">
    <Masthead updated="november 2026" sources="Brå, SCB, Lunds universitet" />
    <ChapterNav />
    <KeyFigures figures={keyFigures} />

    <main>
      <Chapter id="kap1" title="Andelen misstänkta minskade i alla fyra grupper mellan 2007 och 2018">
        <p slot="intro">
          Andelen av befolkningen, 15 år och äldre, som misstänktes för minst ett brott under året. Grupperna bygger
          på var personen och personens föräldrar är födda.
        </p>
        <SuspectsOverTime data={kap1Data} />
        <Fragment slot="note">
          Andelarna är inte justerade för ålder eller kön. Grupperna med utländsk bakgrund har fler unga, och unga
          misstänks oftare. Brå fann att skillnaderna minskar, men inte försvinner, när hänsyn tas till ålder, kön,
          inkomst, utbildning och typ av kommun. Misstänkt är inte detsamma som dömd. Rubriken gäller brott totalt.
          För övergrepp i rättssak anger Brå inga värden för 2007 och 2008.
        </Fragment>
        <Fragment slot="source">
          Källa: Brå rapport 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund.
          Folkbokförda personer 15 år och äldre.
        </Fragment>
      </Chapter>

      <Chapter
        id="kap2"
        title="Överrisken var störst bland födda i Afrika och Centralasien och nära 1 bland födda i Norden, Västeuropa och Östasien"
      >
        <p slot="intro">
          Hur många gånger vanligare det var att misstänkas för brott någon gång 2015–2018 än för inrikesfödda med två
          inrikesfödda föräldrar. Utrikesfödda efter födelseområde eller födelseland, och inrikesfödda med två
          utrikesfödda föräldrar efter moderns födelseområde.
        </p>
        <OriginDots data={kap2Data} />
        <Fragment slot="note">
          En överrisk på 2,0 betyder att det var dubbelt så vanligt att misstänkas som i jämförelsegruppen. Blå punkt är
          ojusterat. Orange punkt är Brås beräkning av hur det hade sett ut om gruppen haft samma fördelning av ålder,
          kön, disponibel inkomst och utbildning som jämförelsegruppen. Det är ett tänkt utfall, inte en faktisk andel.
          Här räknas alla som misstänktes minst en gång under fyra år, så talen per 1 000 är högre än i kapitel 1, som
          visar ett år i taget. Misstänkt är inte detsamma som dömd. Vissa grupper är små: det minsta födelselandet har
          under 5 000 personer. Rubriken gäller brott totalt efter födelseområde.
        </Fragment>
        <Fragment slot="source">
          Källa: <a href="https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund">Brå rapport 2021:9</a>,
          tabellbilaga 1. Folkbokförda 15 år och äldre den 31 december 2014, misstänkta för brott begångna 2015–2018.
        </Fragment>
      </Chapter>

      <Chapter id="kap3" title="Andelen utan svenskt medborgarskap bland nyintagna har minskat sedan 2015">
        <p slot="intro">
          År {lastYear} saknade {formatNumber(newAllLast)} procent av dem som togs in i fängelse svenskt medborgarskap.
          I hela befolkningen var {formatNumber(popShareLast, 1)} procent utländska medborgare.
        </p>
        <Legend
          slot="legend"
          items={[
            { label: 'Nyintagna under året', color: C.focus, mark: 'line' },
            { label: 'Nyintagna män och kvinnor', color: C.focus, mark: 'line', thin: true },
            { label: 'Intagna den 1 oktober', color: C.second, mark: 'line' },
            { label: 'Utländska medborgare i befolkningen', color: C.population, mark: 'dash' },
          ]}
        />
        <LineChart spec={prisonSpec} />
        <Fragment slot="note">
          Medborgarskap är inte födelseland: många utrikesfödda är svenska medborgare. Bland fängelsets utländska
          medborgare finns också personer som inte bor i Sverige och därför inte räknas i befolkningen. Punkter saknas
          för år som Brå inte anger. Uppdelningen på män och kvinnor finns bara för vissa år.
        </Fragment>
        <Fragment slot="source">
          Källor: {
            prisonSources.map((s, i) => (
              <>
                <a href={s.url}>{shortReportName(s.label)}</a>
                {i < prisonSources.length - 1 ? ', ' : ''}
              </>
            ))
          }; SCB, befolkningen den 31 december.
        </Fragment>
      </Chapter>

      <Chapter id="kap4" title="Utländsk bakgrund var vanligare bland dömda för våldtäkt än i befolkningen">
        <p slot="intro">
          Två registerstudier från Lunds universitet av alla som dömts för våldtäkt eller försök till våldtäkt mot en
          kvinna 18 år eller äldre.
        </p>
        <RapeStudies kap4={kap4} />
        <Fragment slot="note">
          Studierna gäller dömda, inte alla som begår våldtäkt. Befolkningens andel gäller alla åldrar och båda könen,
          medan de dömda är män 15–60 år. Befolkningens andel är ett snitt av åren 2000, 2005, 2010 och 2015. Den
          första studien anmäldes till Överklagandenämnden för etikprövning. I den senare studien minskade sambandet
          när hänsyn togs till socioekonomi, missbruk, psykisk sjukdom och tidigare brottslighet, men det fanns kvar.
          Ekonomiskt bistånd är inte ett brott men redovisas i samma tabell i studien.
        </Fragment>
        <Fragment slot="source">
          Källor: <a href="https://doi.org/10.1080/20961790.2020.1868681">Khoshnood m.fl. 2021</a>, Forensic Sciences
          Research, tabell 1 och 2 (dömda 2000–2015);
          <a href="https://lup.lub.lu.se/record/d9a9d1f6-f428-4b57-abf2-5e0e9c7b84f5">Khoshnood m.fl. 2026</a>, Journal
          of Interpersonal Violence (dömda och kontrollgrupp 2000–2020); SCB, befolkningen den 31 december.
        </Fragment>
      </Chapter>

      <Chapter id="kap5" title="Överrisken för utrikesfödda ökade mellan 1985–89 och 1997–2001">
        <p slot="intro">
          Överrisk är andelen misstänkta i gruppen delat med andelen bland inrikesfödda med två inrikesfödda
          föräldrar. Standardiserad överrisk tar hänsyn till kön, ålder, utbildning och förvärvsinkomst.
        </p>
        <OlderStudies kap5={kap5} />
        <Fragment slot="note">
          Siffrorna är över 20 år gamla. En överrisk på 2,0 betyder att det var dubbelt så vanligt att misstänkas som i
          jämförelsegruppen, inrikesfödda med två inrikesfödda föräldrar. För inrikesfödda med utrikesfödda föräldrar
          redovisar Brå standardiserad överrisk bara separat: {formatNumber(kap5.standOneParent, 1)} för dem med en och
          {' '}{formatNumber(kap5.standTwoParents, 1)} för dem med två utrikesfödda föräldrar. Några brottstyper i Brås
          tabell 11 gick inte att läsa ur PDF-filen och saknas här. Misstänkt är inte detsamma som dömd.
        </Fragment>
        <Fragment slot="source">
          Källor: <a href="https://www.bra.se/download/18.cba82f7130f475a2f1800012697/2005_17_brottslighet_bland_personer_fodda_sverige_och_utlandet.pdf">Brå rapport 2005:17</a>,
          tabell 7–11 och bilaga 4 tabell 1. Uppgifterna för 1985–1989 kommer från Brå 1996 och redovisas i tabell 8 i
          Brå 2005:17. Folkbokförda, misstänkta minst en gång under perioden.
        </Fragment>
      </Chapter>

      <Method extraSources={prisonSources} />
    </main>

    <Footer />
  </div>
</Base>
