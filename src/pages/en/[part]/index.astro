---
// The four part pages in English: /en/suspects/, /en/convictions/ and so on (src/lib/parts.ts).
import PartPage from '../../../components/PartPage.astro';
import { parts } from '../../../lib/parts';

export function getStaticPaths() {
  return parts.map((p) => ({ params: { part: p.path.en.replace('/en/', '').replaceAll('/', '') }, props: { partId: p.id } }));
}
const { partId } = Astro.props;
---

<PartPage partId={partId} lang="en" />
