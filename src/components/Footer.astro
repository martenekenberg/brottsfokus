---
import LanguageMenu from './LanguageMenu.astro';
import { tablesIndexPath } from '../lib/dataPages';
import { isLocal, linkLang, localePath, tr, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** This page's path in its language, so the language menu can point to the same page in the other languages. */
  path?: string;
}
const { lang, path = localePath(linkLang(lang), '/') } = Astro.props;
// On a country page the table pages are in English, which the link text says.
const tablesLabel = tr(lang, 'Tabeller och CSV-filer', 'Tables and CSV files', { da: 'Tabeller og CSV-filer (på engelsk)', fi: 'Taulukot ja CSV-tiedostot (englanniksi)' });
---

<footer class="site-footer">
  <span>{tr(lang, 'Brottsfokus · Sammanställning av offentlig statistik', 'Brottsfokus · A compilation of official statistics', { da: 'Brottsfokus · En samling af officiel statistik', fi: 'Brottsfokus · Koonti virallisista tilastoista' })}</span>
  <div class="links">
    <a href={tablesIndexPath(lang)} hreflang={isLocal(lang) ? 'en' : undefined}>{tablesLabel}</a>
    <LanguageMenu path={path} lang={lang} />
    <a href="#top">{tr(lang, 'Till början ↑', 'Back to top ↑', { da: 'Til toppen ↑', fi: 'Alkuun ↑' })}</a>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px 0 48px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 24px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
