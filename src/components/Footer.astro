---
import { tablesIndexPath } from '../lib/dataPages';
---

<footer class="site-footer">
  <span>Brottsfokus · Sammanställning av offentlig statistik</span>
  <span class="links">
    <a href={tablesIndexPath}>Tabeller och CSV-filer</a>
    <a href="#top">Till början ↑</a>
  </span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px 0 48px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
