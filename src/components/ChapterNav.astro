---
// Site menu: the parts, Frågor och svar, Metod and Om sidan. Sticks to the top of the screen while scrolling.
// On the front page, once the big headline has scrolled out of view, a small site title slides in
// at the left, so the headline appears to shrink into the bar. On other pages the small title always
// shows. The bar never changes height, so the page does not jump.
import { aboutPath, faqPath, methodPath, partPath, parts, type PartId } from '../lib/parts';
import { linkLang, localePath, pick, tr, type Lang } from '../lib/i18n';

interface Props {
  /** True on the front page only. */
  home?: boolean;
  /** The page being shown, marked in the menu. */
  current?: PartId | 'faq' | 'metod' | 'om';
  lang: Lang;
}
const { home = false, current, lang } = Astro.props;
// On a country page (Danish, Finnish, Norwegian) the labels are in that language, and the links lead to the
// English pages, except the country's own part page.
const base = linkLang(lang);
const frontPage = localePath(base, '/');
const items = [
  ...parts.map((p) => ({ id: p.id as string, num: String(p.num), label: pick(p.title, lang), href: partPath(p, lang) })),
  { id: 'faq', num: '', label: tr(lang, 'Frågor', 'Q&A', { da: 'Spørgsmål', fi: 'Kysymykset', nb: 'Spørsmål' }), href: faqPath[base] },
  { id: 'metod', num: '', label: tr(lang, 'Metod', 'Method', { da: 'Metode', fi: 'Menetelmä', nb: 'Metode' }), href: methodPath[base] },
  { id: 'om', num: '', label: tr(lang, 'Om sidan', 'About', { da: 'Om siden', fi: 'Tietoa sivustosta', nb: 'Om siden' }), href: aboutPath[base] },
];
---

<nav aria-label={tr(lang, 'Huvudmeny', 'Main menu', { da: 'Hovedmenu', fi: 'Päävalikko', nb: 'Hovedmeny' })} class:list={['chapter-nav', { 'is-compact': !home }]} data-chapter-nav>
  <div class="row">
    {
      home ? (
        <a class="mini-title" href="#top" tabindex="-1" aria-hidden="true">Brottsfokus</a>
      ) : (
        <a class="mini-title" href={frontPage}>Brottsfokus</a>
      )
    }
    <ul>
      {
        items.map((it) => (
          <li>
            <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>
              {it.num && <span class="num">{it.num}</span>}
              {it.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-chapter-nav]');
  // Phones: the menu is one row that scrolls sideways. Fade its right edge while there is more to see,
  // and bring the current page's link into view.
  if (nav) {
    const updateEnd = () => nav.classList.toggle('at-end', nav.scrollLeft + nav.clientWidth >= nav.scrollWidth - 2);
    nav.addEventListener('scroll', updateEnd, { passive: true });
    window.addEventListener('resize', updateEnd);
    const currentLink = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (currentLink && nav.scrollWidth > nav.clientWidth) {
      nav.scrollLeft = Math.max(0, currentLink.offsetLeft - 16);
    }
    updateEnd();
  }
  const headline = document.querySelector<HTMLElement>('.masthead h1');
  const mini = nav?.querySelector<HTMLAnchorElement>('.mini-title');
  // Keep jump links landing just below the menu, whatever its height (it can wrap).
  if (nav && 'ResizeObserver' in window) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--sticky-nav-h', `${nav.offsetHeight}px`);
    }).observe(nav);
  }
  if (nav && headline && mini && 'IntersectionObserver' in window) {
    const setCompact = (on: boolean) => {
      nav.classList.toggle('is-compact', on);
      // Only reachable by keyboard and screen readers while it is visible.
      mini.tabIndex = on ? 0 : -1;
      mini.setAttribute('aria-hidden', String(!on));
    };
    new IntersectionObserver(
      ([entry]) => {
        // Compact once the headline has left the top of the screen (not when it is below it).
        setCompact(!entry.isIntersecting && entry.boundingClientRect.top < 0);
      },
      { threshold: 0 },
    ).observe(headline);
  }
</script>

<style>
  .chapter-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #ffffff;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .row {
    display: flex;
    align-items: center;
  }
  .mini-title {
    flex: none;
    max-width: 0;
    margin-right: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    visibility: hidden;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1;
    /* The serif sits high next to the menu's sans-serif; line it up with the menu text. */
    padding-top: 3px;
    color: var(--ink);
    text-decoration: none;
    transition:
      max-width 0.3s ease,
      margin-right 0.3s ease,
      opacity 0.25s ease,
      transform 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .is-compact .mini-title {
    max-width: 240px;
    margin-right: 24px;
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      max-width 0.3s ease,
      margin-right 0.3s ease,
      opacity 0.25s ease 0.05s,
      transform 0.3s ease,
      visibility 0s;
  }
  .mini-title:hover {
    color: var(--focus);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* Five parts and three pages fit on one row at full width. */
    gap: 0 18px;
    min-width: 0;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--focus);
    text-decoration: underline;
  }
  .num {
    color: var(--second);
    font-weight: 700;
  }
  ul a[aria-current='page'] {
    box-shadow: inset 0 -3px 0 var(--second);
  }
  @media (max-width: 640px) {
    /* One row that scrolls sideways; the small title is its first item. */
    .chapter-nav {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .chapter-nav::-webkit-scrollbar {
      display: none;
    }
    /* More to the right: fade the edge as a hint that the row scrolls. */
    .chapter-nav:not(.at-end) {
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }
    .row {
      width: max-content;
    }
    ul {
      flex-wrap: nowrap;
      gap: 20px;
      white-space: nowrap;
    }
    ul a {
      gap: 6px;
    }
    .mini-title {
      font-size: 18px;
    }
    .is-compact .mini-title {
      margin-right: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-title,
    .is-compact .mini-title {
      transition: none;
    }
  }
</style>
