---
import LanguageMenu from './LanguageMenu.astro';
import { localePath, tr, type BaseLang as Lang } from '../lib/i18n';
import { tablesIndexPath } from '../lib/dataPages';

interface Props {
  updated: string;
  sources: string;
  lang: Lang;
}
const { updated, sources, lang } = Astro.props;
---

<header class="masthead" id="top">
  <div class="meta">
    <span class="label">{tr(lang, 'Offentlig statistik och forskning', 'Official statistics and research')}</span>
    <span>{tr(lang, `Uppdaterad ${updated} · Källor: ${sources}`, `Updated ${updated} · Sources: ${sources}`)}</span>
    <LanguageMenu path={localePath(lang, '/')} lang={lang} />
  </div>
  <h1>Brottsfokus</h1>
  <p class="intro">
    {
      tr(
        lang,
        'Brott i Sverige efter födelseland, föräldrarnas födelseland och medborgarskap, och danska och finska siffror för jämförelse. Officiell statistik och forskning, samlad på ett ställe och jämförd med befolkningen.',
        'Crime in Sweden by country of birth, parents’ country of birth and citizenship, with Danish and Finnish figures for comparison. Official statistics and research, in one place and compared with the population.',
      )
    }
  </p>
  <p class="sub">
    {
      tr(
        lang,
        'Siffrorna visas som Brå, SCB, Danmarks Statistik, Statistikcentralen och forskarna redovisar dem, med källa, år och vad de inte visar. Allt finns också som ',
        'The figures are shown as Brå, SCB, Danmarks Statistik, Statistics Finland and the researchers report them, with source, years and what they do not show. Everything is also available as ',
      )
    }<a href={tablesIndexPath(lang)}>{tr(lang, 'tabeller och CSV-filer', 'tables and CSV files')}</a>.
  </p>
</header>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 48px 0 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .label {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 80px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .intro {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.45;
    color: var(--text-body);
  }
  .sub {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }
  .sub a {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .masthead {
      gap: 10px;
      padding: 28px 0 24px;
    }
    h1 {
      font-size: 44px;
      line-height: 1.02;
    }
    .intro {
      font-size: 20px;
    }
  }
</style>
