---
import { localePath, otherLang, tr, HTML_LANG, type Lang } from '../lib/i18n';

interface Props {
  updated: string;
  sources: string;
  lang: Lang;
}
const { updated, sources, lang } = Astro.props;
const switchLang = otherLang(lang);
---

<header class="masthead" id="top">
  <div class="meta">
    <span class="label">{tr(lang, 'Offentlig statistik och forskning', 'Official statistics and research')}</span>
    <span>{tr(lang, `Uppdaterad ${updated} · Källor: ${sources}`, `Updated ${updated} · Sources: ${sources}`)}</span>
    <a class="switch" href={localePath(switchLang, '/')} hreflang={HTML_LANG[switchLang]}>{tr(lang, 'English', 'Svenska')}</a>
  </div>
  <h1>Brottsfokus</h1>
  <p class="intro">
    {
      tr(
        lang,
        'Vad den officiella statistiken och forskningen visar om misstänkta, dömda och intagna i Sverige efter födelseland, föräldrarnas födelseland och medborgarskap, jämfört med befolkningen.',
        'What official statistics and research show about suspects, convicted people and prisoners in Sweden, by country of birth, parents’ country of birth and citizenship, compared with the population.',
      )
    }
  </p>
</header>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 48px 0 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .label {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 80px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .switch {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }
  .intro {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.45;
    color: var(--text-body);
  }
  @media (max-width: 640px) {
    .masthead {
      gap: 10px;
      padding: 28px 0 24px;
    }
    h1 {
      font-size: 44px;
      line-height: 1.02;
    }
    .intro {
      font-size: 20px;
    }
  }
</style>
