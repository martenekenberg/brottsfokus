---
// The front page: masthead, menu, key figures and one card per part.
// Rendered once per language: src/pages/index.astro (Swedish) and src/pages/en/index.astro (English).
// The chapters live on the part pages (src/components/PartPage.astro).
import Base from '../layouts/Base.astro';
import Masthead from './Masthead.astro';
import ChapterNav from './ChapterNav.astro';
import KeyFigures from './KeyFigures.astro';
import PartCards from './PartCards.astro';
import Footer from './Footer.astro';
import { site, monthYear } from '../lib/site';
import { localePath, tr, type Lang } from '../lib/i18n';
import { buildKeyFigures } from '../lib/keyFigures';
import { chapters, MERGED } from '../lib/chapters';
import { aboutPath, methodPath, partOf } from '../lib/parts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const frontPath = localePath(lang, '/');
const keyFigures = buildKeyFigures(lang);

// Until November 2026 every chapter was on this page, so links like "/#kap3" exist elsewhere.
// The part after "#" never reaches the server, so a small script sends such links on to the right page.
const oldAnchors: Record<string, string> = {
  metod: methodPath[lang],
  om: aboutPath[lang],
  ...Object.fromEntries(chapters.map((c) => [c.id, `${partOf(c.id).path[lang]}#${c.id}`])),
  ...Object.fromEntries(Object.entries(MERGED).map(([old, now]) => [old, `${partOf(now).path[lang]}#${now}`])),
};
const partPaths: Record<string, string> = Object.fromEntries(
  [...chapters.map((c) => c.id), ...Object.keys(MERGED)].map((id) => [id, partOf(MERGED[id] ?? id).path[lang]]),
);
---

<Base title={site.title[lang]} description={site.description[lang]} lang={lang} path={frontPath}>
  <script is:inline define:vars={{ oldAnchors, partPaths }}>
    (function () {
      var id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      // A chapter ("kap3") goes to its page; a chart inside one ("kap7-brott") keeps its own anchor.
      var target = oldAnchors[id];
      if (!target) {
        var m = /^(kap\d+)-/.exec(id);
        if (m && partPaths[m[1]]) target = partPaths[m[1]] + '#' + id;
      }
      if (target) location.replace(target);
    })();
  </script>
  <div class="wrap">
    <Masthead
      updated={monthYear(site.updated, lang)}
      sources={L('Brå, SCB, Lunds och Stockholms universitet, Danmarks Statistik', 'Brå, SCB, Lund and Stockholm universities, Danmarks Statistik')}
      lang={lang}
    />
    <ChapterNav home lang={lang} />
    <KeyFigures figures={keyFigures} />
    <main>
      <PartCards lang={lang} />
    </main>
    <Footer lang={lang} path={frontPath} />
  </div>
</Base>
