---
// The one-page overview: masthead, chapter menu, key figures, all chapters, method and about.
// Rendered once per language: src/pages/index.astro (Swedish) and src/pages/en/index.astro (English).
// Each chapter is its own component in ./chapters/ and loads its own data.
import Base from '../layouts/Base.astro';
import Masthead from './Masthead.astro';
import ChapterNav from './ChapterNav.astro';
import KeyFigures from './KeyFigures.astro';
import Method from './Method.astro';
import Footer from './Footer.astro';
import About from './About.astro';
import Kap1 from './chapters/Kap1.astro';
import Kap2 from './chapters/Kap2.astro';
import Kap3 from './chapters/Kap3.astro';
import Kap4 from './chapters/Kap4.astro';
import Kap5 from './chapters/Kap5.astro';
import Kap6 from './chapters/Kap6.astro';
import Kap7 from './chapters/Kap7.astro';
import Kap8 from './chapters/Kap8.astro';
import Kap9 from './chapters/Kap9.astro';
import Kap10 from './chapters/Kap10.astro';
import { site, monthYear } from '../lib/site';
import { localePath, tr, type Lang } from '../lib/i18n';
import { buildKeyFigures, prisonSources } from '../lib/keyFigures';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const pageTitle = site.title[lang];
const pageDescription = site.description[lang];
const frontPath = localePath(lang, '/');
const keyFigures = buildKeyFigures(lang);
---

<Base title={pageTitle} description={pageDescription} lang={lang} path={frontPath}>
  <div class="wrap">
    <Masthead
      updated={monthYear(site.updated, lang)}
      sources={L('Brå, SCB, Lunds och Stockholms universitet', 'Brå, SCB, Lund and Stockholm universities')}
      lang={lang}
    />
    <ChapterNav lang={lang} />
    <KeyFigures figures={keyFigures} />

    <main>
      <Kap1 lang={lang} />
      <Kap2 lang={lang} />
      <Kap3 lang={lang} />
      <Kap4 lang={lang} />
      <Kap5 lang={lang} />
      <Kap6 lang={lang} />
      <Kap7 lang={lang} />
      <Kap8 lang={lang} />
      <Kap9 lang={lang} />
      <Kap10 lang={lang} />

      <Method extraSources={prisonSources()} lang={lang} />
      <About lang={lang} />
    </main>

    <Footer lang={lang} path={frontPath} />
  </div>
</Base>
