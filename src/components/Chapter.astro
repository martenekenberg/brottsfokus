---
// Shared chapter pattern: kicker, headline, intro, legend, chart,
// "Kort svar" boxes (src/lib/shortAnswers.ts), "Om uppgifterna" panel, "Läs så här" box, source line, a second chart if any (slot "after"), "Läs också" links (src/lib/related.ts), "Nästa" link.
import { chapter, nextLink } from '../lib/chapters';
import ChapterFacts from './ChapterFacts.astro';
import ShortAnswer from './ShortAnswer.astro';
import { chapterShortAnswers } from '../lib/shortAnswers';
import { relatedLinks } from '../lib/related';
import { isLocal, pick, tr, type Lang } from '../lib/i18n';

interface Props {
  id: string;
  title: string;
  /** Page with the chart's numbers as a table and CSV file. */
  tableHref?: string;
  lang: Lang;
}

const { id, title, tableHref, lang } = Astro.props;
const c = chapter(id);
const next = nextLink(id, lang);
const hasLegend = Astro.slots.has('legend');
const hasNote = Astro.slots.has('note');
const hasControls = Astro.slots.has('controls');
const answers = chapterShortAnswers(id, lang);
const related = relatedLinks(id, lang);
---

<section id={id} class="chapter" aria-labelledby={`${id}-h`}>
  <p class="kicker">{c.num ? `${c.num} · ${pick(c.kicker, lang)}` : pick(c.kicker, lang)}</p>
  <h2 id={`${id}-h`}>{title}</h2>
  <div class="intro"><slot name="intro" /></div>
  {answers.length > 0 && <div class="answers">{answers.map((a) => <ShortAnswer item={a} lang={lang} />)}</div>}
  <ChapterFacts id={id} lang={lang} />
  {hasControls && <div class="controls"><slot name="controls" /></div>}
  {hasLegend && <div class="legend"><slot name="legend" /></div>}
  <slot />
  {
    hasNote && (
      <div class="note">
        <strong>{tr(lang, 'Läs så här. ', 'How to read this. ', { da: 'Sådan skal tallene læses. ', fi: 'Näin luvut luetaan. ' })}</strong>
        <slot name="note" />
      </div>
    )
  }
  <p class="source"><slot name="source" /></p>
  {tableHref && <a class="table-link" href={tableHref} hreflang={isLocal(lang) ? 'en' : undefined}>{tr(lang, 'Siffrorna i tabell och som CSV-fil', 'The figures as a table and CSV file', { da: 'Tallene som tabel og CSV-fil (på engelsk)', fi: 'Luvut taulukkona ja CSV-tiedostona (englanniksi)' })}</a>}
  <slot name="after" />
  <nav class="related" aria-label={tr(lang, `Läs också, kapitel ${c.num}`, `See also, chapter ${c.num}`, { da: `Læs også, kapitel ${c.num}`, fi: `Lue myös, luku ${c.num}` })}>
    <p class="related-title">{tr(lang, 'Läs också', 'See also', { da: 'Læs også (på engelsk)', fi: 'Lue myös (englanniksi)' })}</p>
    {
      related.chapters.length > 0 && (
        <ul>
          {related.chapters.map((r) => (
            <li>
              <a href={r.href}>{`${r.num} ${r.label}`}</a>{`: ${r.note}`}
            </li>
          ))}
        </ul>
      )
    }
    <p class="related-terms">
      {tr(lang, 'Begrepp: ', 'Terms: ', { da: 'Begreber: ', fi: 'Käsitteet: ' })}
      {related.terms.map((t, i) => (
        <>
          {i > 0 && ', '}
          <a href={t.href}>{t.label}</a>
        </>
      ))}
    </p>
  </nav>
  <a class="next" href={next.href}>{tr(lang, 'Nästa: ', 'Next: ', { da: 'Næste: ', fi: 'Seuraavaksi: ' })}{next.label} →</a>
</section>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 64px 0;
    border-top: 1px solid var(--ink);
    scroll-margin-top: calc(var(--sticky-nav-h) + 8px);
  }
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1.12;
    font-weight: 500;
  }
  .intro {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-body);
  }
  .intro :global(p) {
    margin: 0;
  }
  /* Short answers: stacked, full width like the rest of the text. */
  .answers {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .note {
    background: var(--panel);
    padding: 16px 20px;
    font-size: 14px;
    line-height: 1.55;
  }
  .note strong {
    font-weight: 600;
  }
  .source {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .source :global(a) {
    color: var(--text-muted);
  }
  .table-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -12px;
    font-size: 13px;
  }
  .related {
    font-size: 14px;
    line-height: 1.5;
    border-top: 1px solid var(--rule);
    padding-top: 12px;
  }
  .related-title {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related li {
    padding: 4px 0;
  }
  .related a {
    color: var(--ink);
  }
  .related-terms {
    margin: 4px 0 0;
    color: var(--text-muted);
  }
  .next {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 0;
  }
  .next:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .chapter {
      gap: 14px;
      padding: 40px 0;
    }
    h2 {
      font-size: 28px;
      line-height: 1.15;
    }
    .intro {
      font-size: 18px;
    }
  }
</style>
