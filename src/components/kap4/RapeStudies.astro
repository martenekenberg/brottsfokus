---
// Chapter 4: main paired bars, then region of birth and prior convictions as two smaller charts.
import BarChart from '../charts/BarChart.astro';
import type { Kap4 } from '../../lib/chapters/kap4';
import { tr, type Lang } from '../../lib/i18n';

interface Props {
  kap4: Kap4;
  lang: Lang;
}

const { kap4, lang } = Astro.props;
---

<div class="chart-block">
  <h3 class="small-title">{tr(lang, 'Dömda och matchad kontrollgrupp, 2000–2020', 'Convicted and matched control group, 2000–2020')}</h3>
  <p class="small-sub">{tr(lang, 'Kontrollgruppen har samma kön och födelseår som de dömda.', 'The control group has the same sex and birth year as the convicted.')}</p>
  <ul class="legend-list" aria-label={tr(lang, 'Förklaring', 'Key')}>
    <li><span class="mark bar-fill" aria-hidden="true"></span>{tr(lang, 'Dömda för våldtäkt', 'Convicted for rape')}</li>
    <li><span class="mark bar-outline" aria-hidden="true"></span>{tr(lang, 'Matchad kontrollgrupp', 'Matched control group')}</li>
  </ul>
  <BarChart spec={kap4.main} />
</div>

<div class="chart-block part">
  <h3 class="small-title">{tr(lang, 'Dömda och hela befolkningen, 2000–2015', 'Convicted and the whole population, 2000–2015')}</h3>
  <p class="small-sub">{tr(lang, 'Befolkningen gäller alla åldrar och båda könen.', 'The population covers all ages and both sexes.')}</p>
  <ul class="legend-list" aria-label={tr(lang, 'Förklaring', 'Key')}>
    <li><span class="mark bar-fill" aria-hidden="true"></span>{tr(lang, 'Dömda för våldtäkt', 'Convicted for rape')}</li>
    <li><span class="mark bar-outline" aria-hidden="true"></span>{tr(lang, 'Befolkningen', 'Population')}</li>
  </ul>
  <BarChart spec={kap4.population2015} />
</div>

<div class="small-multiples">
  <div class="chart-block">
    <h3 class="small-title">{tr(lang, 'Födelseregion bland de utrikesfödda dömda, 2000–2015', 'Birth region among the born-abroad convicted, 2000–2015')}</h3>
    <p class="small-sub">{tr(lang, 'Andel av de 1 451 utrikesfödda dömda.', 'Share of the 1,451 born-abroad convicted.')}</p>
    <BarChart spec={kap4.region} staticWidth={520} />
  </div>
  <div class="chart-block">
    <h3 class="small-title">{tr(lang, 'Tidigare domar och ekonomiskt bistånd bland alla dömda, 2000–2015', 'Previous convictions and social assistance among all convicted, 2000–2015')}</h3>
    <p class="small-sub">{tr(lang, 'Andel av alla dömda i studien. Ekonomiskt bistånd är inte ett brott.', 'Share of all convicted people in the study. Social assistance is not a crime.')}</p>
    <BarChart spec={kap4.prior} staticWidth={520} />
  </div>
</div>

<style>
  .small-multiples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 48px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .part {
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .small-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .small-sub {
    margin: -8px 0 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .bar-fill {
    width: 14px;
    height: 12px;
    background: #1d4e89;
  }
  .bar-outline {
    width: 14px;
    height: 12px;
    border: 1.5px solid #5c5c5c;
    background: #ffffff;
  }
</style>
