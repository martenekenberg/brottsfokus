---
import { renderDotChart, type DotChartSpec } from '../../lib/charts/dot';

interface Props {
  spec: DotChartSpec;
}

const { spec } = Astro.props;
// Static version for readers before (or without) JavaScript.
const staticSvg = renderDotChart(spec, 1040);
---

<figure class="chart" data-dot-chart>
  <div class="canvas" data-canvas set:html={staticSvg} />
  <div class="tooltip" data-tooltip hidden aria-hidden="true"></div>
  <script type="application/json" set:html={JSON.stringify(spec)} />
</figure>

<script>
  import '../../lib/charts/dot-client';
</script>

<style is:global>
  .chart .tt-detail {
    margin: -4px 0 6px;
    color: var(--text-muted);
  }
</style>
