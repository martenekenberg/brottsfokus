---
import { renderLineChart, type LineChartSpec } from '../../lib/charts/line';

interface Props {
  spec: LineChartSpec;
}

const { spec } = Astro.props;
// Static version for readers before (or without) JavaScript.
const staticSvg = renderLineChart(spec, 1040);
---

<figure class="chart" data-line-chart>
  <div class="canvas" data-canvas set:html={staticSvg} />
  <div class="tooltip" data-tooltip hidden aria-hidden="true"></div>
  <script type="application/json" set:html={JSON.stringify(spec)} />
</figure>

<script>
  import '../../lib/charts/line-client';
</script>

<style is:global>
  .chart {
    position: relative;
    margin: 8px 0 0;
  }
  .chart .canvas {
    width: 100%;
    touch-action: pan-y;
  }
  .chart .tooltip {
    position: absolute;
    z-index: 2;
    min-width: 200px;
    max-width: 280px;
    padding: 10px 12px;
    background: #ffffff;
    border: 1px solid var(--ink);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .chart .tt-head {
    font-weight: 700;
    margin-bottom: 6px;
  }
  .chart .tt-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 2px 0;
  }
  .chart .tt-swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .chart .tt-dash {
    width: 14px;
    height: 0;
    border-radius: 0;
    border-top: 2px dashed;
  }
  .chart .tt-val {
    font-weight: 600;
    text-align: right;
  }
  .chart .tt-missing {
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
