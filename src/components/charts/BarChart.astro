---
import { renderBarChart, type BarChartSpec } from '../../lib/charts/bar';

interface Props {
  spec: BarChartSpec;
  /** Width used for the static version drawn at build time. */
  staticWidth?: number;
}

const { spec, staticWidth = 1040 } = Astro.props;
// Static version for readers before (or without) JavaScript.
const staticSvg = renderBarChart(spec, staticWidth);
// Phones get their own version, so the text is readable before the script has run.
const staticNarrow = renderBarChart(spec, 358);
---

<figure class="chart" data-bar-chart>
  <div class="canvas" data-canvas>
    <div class="static-wide" set:html={staticSvg} />
    <div class="static-narrow" set:html={staticNarrow} />
  </div>
  <div class="tooltip" data-tooltip hidden aria-hidden="true"></div>
  <div class="visually-hidden" data-live aria-live="polite"></div>
  <script type="application/json" set:html={JSON.stringify(spec)} />
</figure>

<script>
  import '../../lib/charts/bar-client';
</script>
