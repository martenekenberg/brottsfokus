---
// Bäckman et al. 2021: share convicted before age 25 by birth-year group, men and women side by side,
// as line charts. Used twice: for everyone, and for those who grew up in the lowest-income families.
import LineChart from '../charts/LineChart.astro';
import Legend from '../Legend.astro';
import { buildCohortLineSpec, GROUP_LABEL, SEX_LABEL, type Table } from '../../lib/chapters/kap9';
import { GROUPS } from '../../lib/chapters/kap1';
import type { CohortRow } from '../../lib/data';
import type { BaseLang as Lang } from '../../lib/i18n';

interface Props {
  rows: CohortRow[];
  table: Table;
  lang: Lang;
  /** Show the key above the charts (left out when the slot of a sub-chart already has one). */
  legend?: boolean;
}

const { rows, table, lang, legend = true } = Astro.props;
const legendItems = [
  { label: GROUP_LABEL.utrikesfodd[lang], color: GROUPS.utr.color, mark: 'line' as const },
  { label: GROUP_LABEL.andra_gen[lang], color: GROUPS.u2.color, mark: 'line' as const },
  { label: GROUP_LABEL.native[lang], color: GROUPS.sv2.color, mark: 'line' as const },
];
---

{legend && <Legend items={legendItems} />}

<div class="small-multiples">
  {
    (['man', 'kvinna'] as const).map((sex) => (
      <div class="chart-block">
        <h4 class="small-title">{SEX_LABEL[sex][lang]}</h4>
        <LineChart spec={buildCohortLineSpec(rows, table, sex, lang)} />
      </div>
    ))
  }
</div>

<style>
  .small-multiples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 48px;
  }
  .small-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
</style>
