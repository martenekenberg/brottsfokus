---
// Chapter 9: share convicted before age 25 by birth-year group, men and women side by side.
// Used twice: for everyone, and for those who grew up in the lowest-income families.
import BarChart from '../charts/BarChart.astro';
import { buildCohortSpec, GROUP_LABEL, SEX_LABEL, type Table } from '../../lib/chapters/kap9';
import type { CohortRow } from '../../lib/data';
import { tr, type Lang } from '../../lib/i18n';

interface Props {
  rows: CohortRow[];
  table: Table;
  lang: Lang;
  /** Show the key above the charts (left out when the slot of a sub-chart already has one). */
  legend?: boolean;
}

const { rows, table, lang, legend = true } = Astro.props;
---

{
  legend && (
    <div class="chart-block">
      <ul class="legend-list" aria-label={tr(lang, 'Förklaring', 'Key')}>
        <li><span class="mark" style="width:14px;height:12px;background:#1D4E89" aria-hidden="true" />{GROUP_LABEL.utrikesfodd[lang]}</li>
        <li><span class="mark" style="width:14px;height:12px;background:#C2410C" aria-hidden="true" />{GROUP_LABEL.andra_gen[lang]}</li>
        <li><span class="mark" style="width:14px;height:12px;border:1.5px solid #5C5C5C;background:#FFFFFF" aria-hidden="true" />{GROUP_LABEL.native[lang]}</li>
      </ul>
    </div>
  )
}

<div class="small-multiples">
  {
    (['man', 'kvinna'] as const).map((sex) => (
      <div class="chart-block">
        <h4 class="small-title">{SEX_LABEL[sex][lang]}</h4>
        <BarChart spec={buildCohortSpec(rows, table, sex, lang)} staticWidth={520} />
      </div>
    ))
  }
</div>

<style>
  .small-multiples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 48px;
  }
  .small-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
</style>
