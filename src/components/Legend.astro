---
export interface LegendItem {
  label: string;
  color: string;
  /** dot = filled circle, line = solid line, dash = dashed line */
  mark: 'dot' | 'line' | 'dash';
  /** Thinner line for secondary series. */
  thin?: boolean;
}

interface Props {
  items: LegendItem[];
}

const { items } = Astro.props;
---

<ul class="legend-list">
  {
    items.map((it) => (
      <li>
        <span
          class:list={['mark', it.mark, { thin: it.thin }]}
          style={it.mark === 'dot' ? `background:${it.color}` : `border-color:${it.color}`}
          aria-hidden="true"
        />
        <span>{it.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .legend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 13px;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .mark {
    display: inline-block;
    flex: none;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .line,
  .dash {
    width: 22px;
    height: 0;
    border-top: 3px solid;
  }
  .line.thin {
    border-top-width: 1.5px;
  }
  .dash {
    border-top: 2px dashed;
  }
</style>
