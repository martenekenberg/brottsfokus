---
// Chapter 5: Brå's older studies.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import OlderStudies from '../kap5/OlderStudies.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { loadBra2005 } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { formatNumber } from '../../lib/format';
import { buildKap5 } from '../../lib/chapters/kap5';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n1 = (v: number) => formatNumber(v, 1, lang);

const kap5 = buildKap5(loadBra2005(), lang);

if (!kap5.foreignBornRiskRose) throw new Error('Chapter 5 headline no longer matches the data');
const risk = kap5.foreignBornRisk;
---

<Chapter
  id="kap5"
  lang={lang}
  tableHref={tablePage('kap5', lang).path}
  title={L(
    `Redan kring år 2000 misstänktes utrikesfödda ${n1(risk.p9701)} gånger så ofta, och skillnaden hade ökat sedan 1980-talet`,
    `Around 2000, people born abroad were already suspected ${n1(risk.p9701)} times as often, and the gap had grown since the 1980s`,
  )}
>
  <p slot="intro">
    {L(
      `Brå rapport 2005:17 jämför med inrikesfödda med två inrikesfödda föräldrar. Överrisken för utrikesfödda var ${n1(risk.p8589)} under 1985–89 och ${n1(risk.p9701)} under 1997–2001. Med hänsyn till kön, ålder, utbildning och inkomst (standardiserad överrisk) var den ${n1(risk.stand)}.`,
      `Brå report 2005:17 compares with people born in Sweden with two Swedish-born parents. The excess risk for people born abroad was ${n1(risk.p8589)} in 1985–89 and ${n1(risk.p9701)} in 1997–2001. Taking sex, age, education and income into account (standardised excess risk), it was ${n1(risk.stand)}.`,
    )}
  </p>
  <OlderStudies kap5={kap5} lang={lang} />
  <Fragment slot="note">
    {L(
      `Siffrorna är över 20 år gamla. Misstänkt är inte dömd. För barn till invandrare finns standardiserad överrisk bara separat: ${n1(kap5.standOneParent)} med en och ${n1(kap5.standTwoParents)} med två utrikesfödda föräldrar. Några brottstyper i Brås tabell 11 gick inte att läsa ur PDF-filen och saknas.`,
      `The figures are over 20 years old. Suspected is not convicted. For children of immigrants, standardised excess risk is only given separately: ${n1(kap5.standOneParent)} with one and ${n1(kap5.standTwoParents)} with two foreign-born parents. Some crime types in Brå’s table 11 could not be read from the PDF file and are missing.`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källor: ', 'Sources: ')}<a href="https://www.bra.se/download/18.cba82f7130f475a2f1800012697/2005_17_brottslighet_bland_personer_fodda_sverige_och_utlandet.pdf">{L('Brå rapport 2005:17', 'Brå report 2005:17')}</a>{L(
      ', tabell 7–11 och bilaga 4 tabell 1. Uppgifterna för 1985–1989 kommer från Brå 1996 och redovisas i tabell 8 i Brå 2005:17. Folkbokförda, misstänkta minst en gång under perioden.',
      ', tables 7–11 and appendix 4, table 1. The figures for 1985–1989 come from Brå 1996 and are shown in table 8 of Brå 2005:17. Registered residents, suspected at least once during the period.',
    )}
  </Fragment>
</Chapter>
