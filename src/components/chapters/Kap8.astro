---
// Chapter 8: homicide victims and perpetrators.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import BarChart from '../charts/BarChart.astro';
import { tr, type Lang } from '../../lib/i18n';
import { chapter } from '../../lib/chapters';
import { loadHomicide } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { formatNumber } from '../../lib/format';
import { buildBackgroundSpec, homicideItem, moreThanTwiceForeign, SERIES } from '../../lib/chapters/kap8';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n0 = (v: number) => formatNumber(v, 0, lang);

// ---------- Chapter 8: homicide ----------
const homicide = loadHomicide();
if (!moreThanTwiceForeign(homicide)) throw new Error('Chapter 8 headline no longer matches the data');
const hUtl = homicideItem(homicide, 'utl');
const hMiljo = homicideItem(homicide, 'kriminell_miljo');
const hWeighted = homicideItem(homicide, 'viktat');
const homicideLegend = (
  [
    ['victims', '#1D4E89', false],
    ['perpetrators', '#C2410C', false],
    ['population', '', true],
  ] as const
).map(([k, color, outline]) => ({ label: SERIES[k][lang], color, outline }));
---

<Chapter
  id="kap8"
  lang={lang}
  tableHref={tablePage('kap8', lang).path}
  title={L(
    'Andelen med utländsk bakgrund var mer än dubbelt så stor bland offer och gärningspersoner vid dödligt våld som i befolkningen',
    'The share with a foreign background was more than twice as large among homicide victims and perpetrators as in the population',
  )}
>
  <p slot="intro">
    {L(
      `Alla offer och identifierade gärningspersoner vid dödligt våld i Sverige 2005–2021, jämfört med befolkningen under samma år. ${n0(hUtl.victims as number)} procent av offren och ${n0(hUtl.perpetrators as number)} procent av gärningspersonerna hade utländsk bakgrund, mot ${n0(hUtl.population as number)} procent i befolkningen.`,
      `All homicide victims and identified perpetrators in Sweden in 2005–2021, compared with the population in the same years. ${n0(hUtl.victims as number)}% of victims and ${n0(hUtl.perpetrators as number)}% of perpetrators had a foreign background, against ${n0(hUtl.population as number)}% of the population.`,
    )}
  </p>
  <div class="chart-block">
    <ul class="legend-list" aria-label={L('Förklaring', 'Key')}>
      {
        homicideLegend.map((l) => (
          <li>
            <span class="mark bar-swatch" style={`width:14px;height:12px;${l.outline ? 'border:1.5px solid #5C5C5C;background:#FFFFFF' : `background:${l.color}`}`} aria-hidden="true" />
            {l.label}
          </li>
        ))
      }
    </ul>
    <BarChart spec={buildBackgroundSpec(homicide, lang)} />
  </div>
  <Fragment slot="note">
    {L(
      `Utländsk bakgrund betyder här utrikes född eller inrikes född med två utrikes födda föräldrar, som i kapitel ${chapter('kap1').num} och ${chapter('kap2').num}. Omkring 70 procent av fallen i kriminell miljö är ouppklarade, och där saknas gärningspersoner. Brå har därför också räknat med viktade värden: då hade ${n0(hWeighted.perpetrators as number)} procent av gärningspersonerna utländsk bakgrund. Bara personer med svenskt personnummer ingår. Andelen med utländsk bakgrund var störst vid dödligt våld i kriminell miljö, ${n0(hMiljo.victims as number)} procent av offren och ${n0(hMiljo.perpetrators as number)} procent av gärningspersonerna. Inte justerat för ålder eller kön. Offer och gärningspersoner är oftare unga män än befolkningen i stort. Befolkningens andel är ett snitt för 2005–2021.`,
      `Foreign background here means born abroad, or born in Sweden with two foreign-born parents, as in chapters ${chapter('kap1').num} and ${chapter('kap2').num}. About 70% of the cases in criminal milieus are unsolved and have no identified perpetrator. Brå therefore also calculated weighted values: with them, ${n0(hWeighted.perpetrators as number)}% of perpetrators had a foreign background. Only people with a Swedish personal identity number are included. The share with a foreign background was highest for homicides in criminal milieus: ${n0(hMiljo.victims as number)}% of victims and ${n0(hMiljo.perpetrators as number)}% of perpetrators. Not adjusted for age or sex. Victims and perpetrators are more often young men than the population as a whole. The population share is an average for 2005–2021.`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2025-03-25-offer-och-garningspersoner-vid-dodligt-vald">{L('Brå rapport 2025:5', 'Brå report 2025:5')}</a>{L(
      ', Offer och gärningspersoner vid dödligt våld, s. 13, 76–79. 1 521 offer och 1 175 gärningspersoner 2005–2021.',
      ', Offer och gärningspersoner vid dödligt våld (homicide victims and perpetrators), p. 13, 76–79. 1,521 victims and 1,175 perpetrators, 2005–2021.',
    )}
  </Fragment>
</Chapter>
