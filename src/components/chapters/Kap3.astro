---
// Chapter 3: prison and citizenship.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import Legend from '../Legend.astro';
import LineChart from '../charts/LineChart.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { loadPopulation, loadPrison } from '../../lib/data';
import { buildKap3, kap3Context, kap3HasGaps, shortReportName } from '../../lib/chapters/kap3';
import { tablePage } from '../../lib/dataPages';
import { part } from '../../lib/parts';
import { formatNumber } from '../../lib/format';
import type { LineChartSpec } from '../../lib/charts/line';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n0 = (v: number) => formatNumber(v, 0, lang);
const n1 = (v: number) => formatNumber(v, 1, lang);

const C = {
  ink: '#121212',
  muted: '#5C5C5C',
  focus: '#1D4E89',
  second: '#C2410C',
  population: '#8A8A8A',
};

// ---------- Chapter 3: prison and citizenship ----------
const prison = loadPrison();
const population = loadPopulation();

const kap3 = buildKap3(prison, population);
const { popShare, newAll, newMen, newWomen, onOct1, firstYear, lastYear } = kap3;
const prisonYears = kap3.years;
const byYear = (m: Map<number, number | null>) => prisonYears.map((y) => m.get(y) ?? null);

const newAllLast = newAll.get(lastYear);
const popShareLast = popShare.get(lastYear);
if (newAllLast == null || popShareLast == null) throw new Error(`Missing ${lastYear} values for chapter 3`);

// The intro says the share has fallen since its highest year. Stop the build if the data no longer says so.
const peakYear = prisonYears.reduce((best, y) => ((newAll.get(y) ?? -1) > (newAll.get(best) ?? -1) ? y : best), firstYear);
const newAllPeak = newAll.get(peakYear) as number;
if (!(newAllLast < newAllPeak) || peakYear === lastYear) throw new Error('Chapter 3 intro no longer matches the data');
// The headline says "more than one in five" new prisoners lacked Swedish citizenship, "nearly three times" the
// population share. Stop the build if the last year no longer says so.
const prisonRatio = newAllLast / popShareLast;
if (!(newAllLast > 20 && newAllLast < 25) || !(prisonRatio >= 2.6 && prisonRatio < 3)) {
  throw new Error('Chapter 3 headline no longer matches the data');
}
// The part card repeats the headline with its year. Stop the build when new data makes that year out of date.
if (!(['sv', 'en'] as const).every((l) => part('fangelse').card[l].includes(String(lastYear)))) {
  throw new Error(`Part 3 card no longer names ${lastYear}; update it in src/lib/parts.ts`);
}

const prisonMax = Math.max(...[newAll, newMen, newWomen, onOct1].flatMap((m) => [...m.values()].map((v) => v ?? 0)));
// Both charts use the same scale, so men and women can be compared with all new prisoners above.
const yMax = Math.max(40, Math.ceil(prisonMax / 10) * 10);
const populationSeries = {
  id: 'bef',
  label: L('Utländska medborgare i befolkningen', 'Foreign citizens in the population'),
  endLabel: L('befolkningen', 'population'),
  endLabelShort: '',
  color: C.population,
  textColor: C.muted,
  strokeWidth: 2,
  dashed: true,
  dotRadius: 2.5,
  values: byYear(popShare),
  format: 'pct1' as const,
};

// Main chart: all new prisoners, prisoners on 1 October, and the population.
const prisonSpec: LineChartSpec = {
  lang,
  years: prisonYears,
  yMax,
  yTickStep: 10,
  yFormat: 'pct',
  ariaLabel: L(
    'Linjediagram. Andel utan svenskt medborgarskap bland nyintagna i fängelse och bland intagna den 1 oktober, ' +
      `${firstYear} till ${lastYear}, jämfört med andelen utländska medborgare i befolkningen. ` +
      `År ${lastYear} var andelen ${formatNumber(newAllLast, 0, 'sv')} procent bland nyintagna och ` +
      `${formatNumber(popShareLast, 1, 'sv')} procent i befolkningen. År som saknas har inget värde.`,
    `Line chart. Share without Swedish citizenship among new prisoners and among people in prison on 1 October, ` +
      `${firstYear} to ${lastYear}, compared with the share of foreign citizens in the population. ` +
      `In ${lastYear} the share was ${formatNumber(newAllLast, 0, 'en')}% among new prisoners and ` +
      `${formatNumber(popShareLast, 1, 'en')}% in the population. Missing years have no value.`,
  ),
  series: [
    {
      id: 'ny-alla',
      label: L('Nyintagna, alla', 'New prisoners, all'),
      endLabel: L('nyintagna', 'new prisoners'),
      endLabelShort: L('nyintagna', 'new'),
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 3,
      dotRadius: 3.5,
      values: byYear(newAll),
      annotate: [peakYear],
      format: 'pct',
    },
    {
      id: 'okt',
      label: L('Intagna den 1 oktober', 'Prisoners on 1 October'),
      endLabel: L('1 oktober', '1 October'),
      endLabelShort: L('1 okt', '1 Oct'),
      color: C.second,
      textColor: C.second,
      strokeWidth: 2.5,
      dotRadius: 3.5,
      values: byYear(onOct1),
      format: 'pct',
    },
    populationSeries,
  ],
};

// Second chart: new prisoners by sex, on the same scale.
const sexSpec: LineChartSpec = {
  lang,
  years: prisonYears,
  yMax,
  yTickStep: 10,
  yFormat: 'pct',
  ariaLabel: L(
    `Linjediagram. Andel utan svenskt medborgarskap bland nyintagna män och kvinnor, ${firstYear} till ${lastYear}, ` +
      `jämfört med andelen utländska medborgare i befolkningen. År ${lastYear}: ` +
      `${formatNumber(newMen.get(lastYear) ?? NaN, 0, 'sv')} procent bland män och ${formatNumber(newWomen.get(lastYear) ?? NaN, 0, 'sv')} procent bland kvinnor. År som saknas har inget värde.`,
    `Line chart. Share without Swedish citizenship among new prisoners, men and women, ${firstYear} to ${lastYear}, ` +
      `compared with the share of foreign citizens in the population. In ${lastYear}: ` +
      `${formatNumber(newMen.get(lastYear) ?? NaN, 0, 'en')}% among men and ${formatNumber(newWomen.get(lastYear) ?? NaN, 0, 'en')}% among women. Missing years have no value.`,
  ),
  series: [
    {
      id: 'ny-man',
      label: L('Nyintagna män', 'New prisoners, men'),
      endLabel: L('män', 'men'),
      endLabelShort: L('män', 'men'),
      color: C.focus,
      textColor: C.focus,
      strokeWidth: 2.5,
      dotRadius: 3,
      values: byYear(newMen),
      format: 'pct',
    },
    {
      id: 'ny-kvinnor',
      label: L('Nyintagna kvinnor', 'New prisoners, women'),
      endLabel: L('kvinnor', 'women'),
      endLabelShort: L('kvinnor', 'women'),
      color: C.second,
      textColor: C.second,
      strokeWidth: 2.5,
      dotRadius: 3,
      values: byYear(newWomen),
      format: 'pct',
    },
    populationSeries,
  ],
};

const prisonSources = kap3.sources;
---

<Chapter
  id="kap3"
  lang={lang}
  tableHref={tablePage('kap3', lang).path}
  title={L(
    `Mer än var femte som togs in i fängelse ${lastYear} saknade svenskt medborgarskap, nästan tre gånger andelen i befolkningen`,
    `More than one in five people taken into prison in ${lastYear} were not Swedish citizens, nearly three times the share in the population`,
  )}
>
  <p slot="intro">
    {L(
      `Av de nyintagna saknade ${n0(newAllLast)} procent svenskt medborgarskap, mot ${n1(popShareLast)} procent utländska medborgare i hela befolkningen. Andelen var högst ${peakYear}, ${n0(newAllPeak)} procent, och har sedan minskat.`,
      `${n0(newAllLast)}% of new prisoners were not Swedish citizens, against ${n1(popShareLast)}% foreign citizens in the whole population. The share was highest in ${peakYear}, at ${n0(newAllPeak)}%, and has fallen since.`,
    )}
  </p>
  <Legend
    slot="legend"
    items={[
      { label: L('Nyintagna under året', 'New prisoners during the year'), color: C.focus, mark: 'line' },
      { label: L('Intagna den 1 oktober', 'Prisoners on 1 October'), color: C.second, mark: 'line' },
      { label: L('Utländska medborgare i befolkningen', 'Foreign citizens in the population'), color: C.population, mark: 'dash' },
    ]}
  />
  <LineChart spec={prisonSpec} />
  <div class="chart-block sex-chart">
    <p class="chart-heading">{L('Nyintagna män och kvinnor', 'New prisoners, men and women')}</p>
    <Legend
      items={[
        { label: L('Män', 'Men'), color: C.focus, mark: 'line' },
        { label: L('Kvinnor', 'Women'), color: C.second, mark: 'line' },
        { label: L('Utländska medborgare i befolkningen', 'Foreign citizens in the population'), color: C.population, mark: 'dash' },
      ]}
    />
    <LineChart spec={sexSpec} />
  </div>
  <Fragment slot="note">
    {L(
      'Medborgarskap är inte födelseland: många som är födda utomlands är svenska medborgare. Bland de intagna finns också personer som inte bor i Sverige och inte räknas i befolkningen.' + (kap3HasGaps(kap3) ? ' Punkter saknas för år som Brå inte anger.' : '') + ' ',
      'Citizenship is not country of birth: many people born abroad are Swedish citizens. The prisoners also include people who do not live in Sweden and are not counted in the population.' + (kap3HasGaps(kap3) ? ' Points are missing for years that Brå does not report.' : '') + ' ',
    )}
    {kap3Context(kap3, lang)}
  </Fragment>
  <Fragment slot="source">
    {L('Källor: ', 'Sources: ')}
    {
      prisonSources.map((s, i) => (
        <>
          <a href={s.url}>{shortReportName(s.label)}</a>
          {i < prisonSources.length - 1 ? ', ' : ''}
        </>
      ))
    }
    {L('; SCB, befolkningen den 31 december.', '; SCB, population on 31 December.')}
  </Fragment>
</Chapter>

<style>
  .sex-chart {
    margin-top: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
</style>
