---
// Convicted before age 25: Brå's birth-cohort statistics (Brå 2025:21, born 1958–2003) and the
// Stockholm University study (Bäckman et al. 2021, born 1966–93), merged into one chapter at the
// owner's request (November 2026). The chapter keeps the id "kap9"; old links to "#kap10" are sent here.
// Loads its own data and stops the build if a headline no longer matches the data.
import Chapter from '../Chapter.astro';
import Legend from '../Legend.astro';
import LineChart from '../charts/LineChart.astro';
import SubChart from '../SubChart.astro';
import Cohorts from '../kap9/Cohorts.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { loadBirthCohorts, loadCohorts } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { formatNumber } from '../../lib/format';
import { birthYears, buildKohortSpec, fellInAllGroups, firstBackgroundYear, kohortValue, lowestInAllGroups } from '../../lib/chapters/kap10';
import { allFell, cell as cohortCell, cohorts as cohortList, smallerInLowIncome } from '../../lib/chapters/kap9';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n1 = (v: number) => formatNumber(v, 1, lang);

// ---------- Brå 2025:21, birth cohorts ----------
const kohort = loadBirthCohorts();
const k25Years = birthYears(kohort, 'fore25');
const k20Years = birthYears(kohort, 'fore20');
const kBg = firstBackgroundYear(kohort, 'fore25');
const k25Last = k25Years[k25Years.length - 1];
const k20Last = k20Years[k20Years.length - 1];
const kv = (m: 'fore25' | 'fore20', g: 'alla' | 'I20' | 'I11' | 'I02' | 'Utr', y: number) => {
  const v = kohortValue(kohort, m, 'samtliga', g, y);
  if (v === null) throw new Error(`Convicted before 25: no value ${m} ${g} ${y}`);
  return n1(v);
};
const kohortLegend = [
  { label: L('Utrikesfödda', 'Born abroad'), color: '#1D4E89', mark: 'line' as const },
  { label: L('Inrikesfödda med två utrikesfödda föräldrar', 'Born in Sweden, two foreign-born parents'), color: '#C2410C', mark: 'line' as const },
  { label: L('Inrikesfödda med en utrikesfödd förälder', 'Born in Sweden, one foreign-born parent'), color: '#0F766E', mark: 'line' as const },
  { label: L('Inrikesfödda med två inrikesfödda föräldrar', 'Born in Sweden, two Swedish-born parents'), color: '#121212', mark: 'line' as const },
  { label: L('Alla födda det året', 'Everyone born that year'), color: '#8A8A8A', mark: 'dash' as const },
];

// ---------- Bäckman et al. 2021 ----------
const cohortRows = loadCohorts();
const cohortNames = cohortList(cohortRows);
const cFirst = cohortNames[0];
const cLast = cohortNames[cohortNames.length - 1];
const cm = (c: string, g: 'utrikesfodd' | 'andra_gen' | 'native', sex: 'man' | 'kvinna' = 'man', t: 'alla' | 'laginkomst' = 'alla') =>
  n1(cohortCell(cohortRows, t, sex, c, g).pct);

// ---------- Headline checks ----------
// Chapter intro and the Bäckman intro: the share fell in every background group, in both sources.
if (!fellInAllGroups(kohort, 'fore25', kBg, k25Last) || !allFell(cohortRows)) {
  throw new Error('Convicted before 25: chapter headline no longer matches the data');
}
// Headline: people born abroad and people born in Sweden with two foreign-born parents were convicted before 25
// "nearly twice as often" as those with two Swedish-born parents, for the last birth year. Stop the build if not.
const k25Ratio = (g: 'Utr' | 'I02') =>
  (kohortValue(kohort, 'fore25', 'samtliga', g, k25Last) as number) / (kohortValue(kohort, 'fore25', 'samtliga', 'I20', k25Last) as number);
if (!(['Utr', 'I02'] as const).every((g) => k25Ratio(g) >= 1.75 && k25Ratio(g) < 2)) {
  throw new Error('Convicted before 25: chapter headline no longer matches the data');
}
// Bäckman headline: among men in the last birth-year group, those born abroad were convicted nearly twice as often.
const backmanRatio = cohortCell(cohortRows, 'alla', 'man', cLast, 'utrikesfodd').pct / cohortCell(cohortRows, 'alla', 'man', cLast, 'native').pct;
if (!(backmanRatio >= 1.75 && backmanRatio < 2)) throw new Error('Bäckman chart: headline no longer matches the data');
// Before age 20: the last birth year has the lowest share in every group.
if (!lowestInAllGroups(kohort, 'fore20', k20Last)) throw new Error('Convicted before 20: headline no longer matches the data');
// Its note says the share was higher for those born the year after k25Last than for those born in k25Last, in every group.
if (!fellInAllGroups(kohort, 'fore20', k25Last + 1, k25Last)) throw new Error('Convicted before 20: note no longer matches the data');
if (!smallerInLowIncome(cohortRows)) throw new Error('Bäckman low-income chart: headline no longer matches the data');
// Women from low-income families born 1978 or later: lowest share among the born abroad in every group.
const bornAbroadLowest = cohortNames
  .filter((c) => c >= '1978')
  .every((c) => {
    const v = (g: 'utrikesfodd' | 'andra_gen' | 'native') => cohortCell(cohortRows, 'laginkomst', 'kvinna', c, g).pct;
    return v('utrikesfodd') < v('andra_gen') && v('utrikesfodd') < v('native');
  });
if (!bornAbroadLowest) throw new Error('Bäckman low-income chart: intro no longer matches the data');
---

<Chapter
  id="kap9"
  lang={lang}
  tableHref={tablePage('kap10', lang).path}
  title={L(
    'Utrikesfödda och barn till två invandrare lagfördes nästan dubbelt så ofta före 25 års ålder',
    'People born abroad and children of two immigrants were convicted nearly twice as often before age 25',
  )}
>
  <p slot="intro">
    {L(
      `Andel av varje födelseår som lagförts för brott minst en gång före 25 års ålder. Bland födda ${k25Last}: ${kv('fore25', 'Utr', k25Last)} procent av de utrikesfödda, ${kv('fore25', 'I02', k25Last)} procent av inrikesfödda med två utrikesfödda föräldrar och ${kv('fore25', 'I20', k25Last)} procent av dem med två inrikesfödda föräldrar. Andelen har minskat i alla grupper, från ${kv('fore25', 'alla', k25Years[0])} procent av alla födda ${k25Years[0]} till ${kv('fore25', 'alla', k25Last)} procent av födda ${k25Last}, men skillnaderna finns kvar.`,
      `Share of each birth year convicted of a crime at least once before age 25. Among those born in ${k25Last}: ${kv('fore25', 'Utr', k25Last)}% of people born abroad, ${kv('fore25', 'I02', k25Last)}% of people born in Sweden with two foreign-born parents and ${kv('fore25', 'I20', k25Last)}% of those with two Swedish-born parents. The share has fallen in every group, from ${kv('fore25', 'alla', k25Years[0])}% of everyone born in ${k25Years[0]} to ${kv('fore25', 'alla', k25Last)}% of those born in ${k25Last}, but the differences remain.`,
    )}
  </p>
  <Legend slot="legend" items={kohortLegend} />
  <LineChart spec={buildKohortSpec(kohort, 'fore25', 'samtliga', lang)} />
  <Fragment slot="note">
    {L(
      `Kvinnor och män tillsammans. Bara den som var folkbokförd i Sverige vid 15 års ålder och när beslutet kom räknas, så den som invandrat senare är inte med. Lagförd betyder dom i tingsrätt, strafföreläggande eller åtalsunderlåtelse, även om personen senare friats i högre rätt. Bakgrund finns bara för födda från ${kBg}. Inte justerat för till exempel familjens inkomst. Studien längre ner delar in bakgrund på ett annat sätt.`,
      `Women and men together. Only people registered in Sweden at age 15 and when the decision was made are counted, so people who moved here later are not included. Convicted means a district court judgment, a summary penalty or a waiver of prosecution, even if the person was later acquitted by a higher court. Background is only available for those born from ${kBg}. Not adjusted for, for example, family income. The study further down groups background differently.`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2025-12-02-fodelsekohortstatistik">{L('Brå rapport 2025:21', 'Brå report 2025:21')}</a>{L(
      ', Födelsekohortstatistik, tabell 1. Personer folkbokförda i Sverige vid 15 års ålder, lagföringar till och med 2023.',
      ', Födelsekohortstatistik (birth cohort statistics), table 1. People registered in Sweden at age 15, convictions up to the end of 2023.',
    )}
  </Fragment>

  <Fragment slot="after">
    <SubChart
      id="kap10-fore20"
      lang={lang}
      title={L(
        `Före 20 års ålder var andelen den lägsta hittills bland födda ${k20Last}, i alla grupper`,
        `Before age 20, the share was the lowest so far among those born in ${k20Last}, in every group`,
      )}
    >
      <Fragment slot="intro">
        {L(
          `Samma mått före 20 års ålder, som går att följa till födda ${k20Last}. Bland utrikesfödda föll andelen från ${kv('fore20', 'Utr', kBg)} procent för födda ${kBg} till ${kv('fore20', 'Utr', k20Last)} procent för födda ${k20Last}, mot ${kv('fore20', 'I20', k20Last)} procent för dem med två inrikesfödda föräldrar.`,
          `The same measure before age 20, which can be followed up to those born in ${k20Last}. Among people born abroad, the share fell from ${kv('fore20', 'Utr', kBg)}% for those born in ${kBg} to ${kv('fore20', 'Utr', k20Last)}% for those born in ${k20Last}, against ${kv('fore20', 'I20', k20Last)}% for those with two Swedish-born parents.`,
        )}
      </Fragment>
      <Legend slot="legend" items={kohortLegend} />
      <LineChart spec={buildKohortSpec(kohort, 'fore20', 'samtliga', lang)} />
      <Fragment slot="note">
        {L(
          `Rubriken gäller födelseåren från ${kBg}. Andelen minskade inte varje år: för födda ${k25Last + 1} var den något högre än för födda ${k25Last}, i alla grupper. Andelarna är lägre än före 25, eftersom många lagförs första gången mellan 20 och 25 år.`,
          `The headline covers birth years from ${kBg}. The share did not fall every year: for those born in ${k25Last + 1} it was slightly higher than for those born in ${k25Last}, in every group. The shares are lower than before 25, because many people are first convicted between 20 and 25.`,
        )}
      </Fragment>
      <Fragment slot="source">
        {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2025-12-02-fodelsekohortstatistik">{L('Brå rapport 2025:21', 'Brå report 2025:21')}</a>{L(', tabell 4 (kolumnen 20 år).', ', table 4 (column 20 years).')}
      </Fragment>
    </SubChart>

    <SubChart
      id="kap9-backman"
      lang={lang}
      tableHref={tablePage('kap9', lang).path}
      title={L(
        `Även i en studie från Stockholms universitet lagfördes utrikesfödda unga män nästan dubbelt så ofta`,
        `In a study from Stockholm University too, young men born abroad were convicted nearly twice as often`,
      )}
    >
      <Fragment slot="intro">
        {L(
          `Andel lagförda före 25 års ålder bland födda ${cFirst.slice(0, 4)}–${cLast.slice(0, 2)}${cLast.slice(-2)}. Bland män födda ${cLast}: ${cm(cLast, 'utrikesfodd')} procent av de utrikesfödda, ${cm(cLast, 'andra_gen')} procent av inrikesfödda med två utrikesfödda föräldrar och ${cm(cLast, 'native')} procent av övriga. Andelarna har minskat i alla grupper, från ${cm(cFirst, 'utrikesfodd')}, ${cm(cFirst, 'andra_gen')} och ${cm(cFirst, 'native')} procent bland män födda ${cFirst}.`,
          `Share convicted before age 25 among those born in ${cFirst.slice(0, 4)}–${cLast.slice(0, 2)}${cLast.slice(-2)}. Among men born in ${cLast}: ${cm(cLast, 'utrikesfodd')}% of those born abroad, ${cm(cLast, 'andra_gen')}% of people born in Sweden with two foreign-born parents and ${cm(cLast, 'native')}% of the others. The shares have fallen in every group, from ${cm(cFirst, 'utrikesfodd')}%, ${cm(cFirst, 'andra_gen')}% and ${cm(cFirst, 'native')}% among men born in ${cFirst}.`,
        )}
      </Fragment>
      <Cohorts rows={cohortRows} table="alla" lang={lang} />
      <Fragment slot="note">
        {L(
          `Varje grupp följs från 15 till 24 års ålder, och bara den som var folkbokförd i Sverige hela den tiden ingår. Lagförd betyder dom, strafföreläggande eller åtalsunderlåtelse. ”Övriga” är inrikesfödda med minst en inrikesfödd förälder. Män och kvinnor har olika skala, eftersom andelarna är mycket lägre bland kvinnor.`,
          `Each group is followed from age 15 to 24, and only people registered in Sweden for that whole time are included. Convicted means a court sentence, a summary penalty or a waiver of prosecution. “The others” are people born in Sweden with at least one Swedish-born parent. Men and women have different scales, because the shares are much lower among women.`,
        )}
      </Fragment>
      <Fragment slot="source">
        {L('Källa: ', 'Source: ')}<a href="https://doi.org/10.1080/2578983X.2021.1900038">{L('Bäckman, Estrada, Nilsson och Sivertsson 2021', 'Bäckman, Estrada, Nilsson and Sivertsson 2021')}</a>{L(
          ', Criminal convictions and immigrant background 1973–2017 in Sweden, Nordic Journal of Criminology 22(2), tabell 1. Stockholms universitet. CC BY 4.0.',
          ', Criminal convictions and immigrant background 1973–2017 in Sweden, Nordic Journal of Criminology 22(2), table 1. Stockholm University. CC BY 4.0.',
        )}
      </Fragment>
    </SubChart>

    <SubChart
      id="kap9-laginkomst"
      lang={lang}
      tableHref={tablePage('kap9', lang).path}
      title={L(
        'I familjerna med lägst inkomster var skillnaderna mindre',
        'In the families with the lowest incomes, the differences were smaller',
      )}
    >
      <Fragment slot="intro">
        {L(
          `Samma mått för dem som växte upp i den tiondel av familjerna som hade lägst inkomster. Bland män födda ${cLast}: ${cm(cLast, 'utrikesfodd', 'man', 'laginkomst')}, ${cm(cLast, 'andra_gen', 'man', 'laginkomst')} och ${cm(cLast, 'native', 'man', 'laginkomst')} procent. Bland kvinnor födda 1978 eller senare var andelen lägst bland de utrikesfödda.`,
          `The same measure for those who grew up in the tenth of families with the lowest incomes. Among men born in ${cLast}: ${cm(cLast, 'utrikesfodd', 'man', 'laginkomst')}%, ${cm(cLast, 'andra_gen', 'man', 'laginkomst')}% and ${cm(cLast, 'native', 'man', 'laginkomst')}%. Among women born in 1978 or later, the share was lowest among those born abroad.`,
        )}
      </Fragment>
      <Cohorts rows={cohortRows} table="laginkomst" lang={lang} />
      <Fragment slot="note">
        {L(
          `Lägst inkomster: föräldrarnas sammanlagda arbetsinkomst låg i den lägsta tiondelen minst två av tre år när personen var 15–17 år. Andra skillnader mellan grupperna är inte med. Grupperna är mindre, så siffrorna svänger mer. Samma skala som ovan.`,
          `Lowest incomes: the parents’ combined income from work was in the lowest tenth in at least two of three years when the person was 15–17. Other differences between the groups are not taken into account. The groups are smaller, so the figures vary more. Same scale as above.`,
        )}
      </Fragment>
      <Fragment slot="source">
        {L('Källa: ', 'Source: ')}<a href="https://doi.org/10.1080/2578983X.2021.1900038">{L('Bäckman m.fl. 2021', 'Bäckman et al. 2021')}</a>{L(', tabell 2.', ', table 2.')}
      </Fragment>
    </SubChart>
  </Fragment>
</Chapter>
