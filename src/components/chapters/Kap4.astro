---
// Chapter 4: people convicted of rape.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import RapeStudies from '../kap4/RapeStudies.astro';
import { tr, type Lang } from '../../lib/i18n';
import { loadPopulation, loadRapeStudies } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { formatNumber } from '../../lib/format';
import { buildKap4 } from '../../lib/chapters/kap4';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n1 = (v: number) => formatNumber(v, 1, lang);

const population = loadPopulation();

const kap4 = buildKap4(loadRapeStudies(), population, lang);
// The headline says "drygt hälften" (just over half) were born abroad. Stop the build if the data no longer says so.
if (!(kap4.utrConvicted > 50 && kap4.utrConvicted < 55) || !(kap4.utrControls < kap4.utrConvicted)) {
  throw new Error('Chapter 4 headline no longer matches the data');
}
const kap4ControlsPct = formatNumber(kap4.utrControls, 0, lang);

---

<Chapter
  id="kap4"
  lang={lang}
  tableHref={tablePage('kap4', lang).path}
  title={L(
    `Drygt hälften av de dömda för våldtäkt ${kap4.period} var utrikesfödda, mot ${kap4ControlsPct} procent i en kontrollgrupp`,
    `Just over half of those convicted of rape in ${kap4.period} were born abroad, against ${kap4ControlsPct}% in a control group`,
  )}
>
  <p slot="intro">
    {L(
      'Två registerstudier från Lunds universitet av alla som dömts för våldtäkt eller försök till våldtäkt mot en kvinna 18 år eller äldre. Kontrollgruppen har samma kön och födelseår som de dömda.',
      'Two register studies from Lund University of everyone convicted of rape or attempted rape against a woman aged 18 or older. The control group has the same sex and birth year as the convicted.',
    )}
  </p>
  <RapeStudies kap4={kap4} lang={lang} />
  <Fragment slot="note">
    {L(
      `Studierna gäller dömda, inte alla som begår våldtäkt. De dömda är nästan bara män (${n1(kap4.menPct)} procent), 15–60 år, medan befolkningens andel gäller alla åldrar och båda könen. Med hänsyn till bland annat socioekonomi och tidigare brottslighet minskade sambandet, men det fanns kvar. Det översta stapelparet är alla utom inrikesfödda med två inrikesfödda föräldrar (${n1(kap4.sv2Convicted)} procent av de dömda, ${n1(kap4.sv2Controls)} procent av kontrollgruppen). Den första studien anmäldes till Överklagandenämnden för etikprövning.`,
      `The studies cover people who were convicted, not everyone who commits rape. The convicted are almost all men (${n1(kap4.menPct)}%), aged 15–60, while the population share covers all ages and both sexes. Taking socioeconomic factors and earlier crime into account, among other things, weakened the link, but it remained. The top pair of bars is everyone except people born in Sweden with two Swedish-born parents (${n1(kap4.sv2Convicted)}% of the convicted, ${n1(kap4.sv2Controls)}% of the control group). The first study was reported to the Swedish appeals board for ethical review (Överklagandenämnden för etikprövning).`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källor: ', 'Sources: ')}<a href="https://doi.org/10.1080/20961790.2020.1868681">{L('Khoshnood m.fl. 2021', 'Khoshnood et al. 2021')}</a>{L(
      ', Forensic Sciences Research, tabell 1 och 2 (dömda 2000–2015); ',
      ', Forensic Sciences Research, tables 1 and 2 (convicted 2000–2015); ',
    )}
    <a href="https://lup.lub.lu.se/record/d9a9d1f6-f428-4b57-abf2-5e0e9c7b84f5">{L('Khoshnood m.fl. 2026', 'Khoshnood et al. 2026')}</a>{L(
      ', Journal of Interpersonal Violence, tabell 1 (dömda och kontrollgrupp 2000–2020); SCB, befolkningen den 31 december.',
      ', Journal of Interpersonal Violence, table 1 (convicted and control group 2000–2020); SCB, population on 31 December.',
    )}
  </Fragment>
</Chapter>
