---
// Chapter 6: victims of crime (NTU).
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import Victims from '../kap6/Victims.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { chapter } from '../../lib/chapters';
import { loadNtu } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { swedishHigher } from '../../lib/chapters/kap6';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);

const ntu = loadNtu();

// The chapter 6 headline names one exception: sexual offences against women. Stop the build if the data says otherwise.
if (JSON.stringify(swedishHigher(ntu)) !== JSON.stringify([{ crimeId: 'sexualbrott', sex: 'kvinnor' }])) {
  throw new Error('Chapter 6 headline no longer matches the data');
}

---

<Chapter
  id="kap6"
  lang={lang}
  tableHref={tablePage('kap6', lang).path}
  title={L(
    'Personer med utländsk bakgrund uppgav oftare att de utsatts för brott, utom kvinnor för sexualbrott',
    'People with a foreign background more often said they had been victims of crime, except women for sexual offences',
  )}
>
  <p slot="intro">
    {L(
      'Andel av befolkningen 16–84 år som säger att de utsatts för brottet under året före undersökningen. Svaren gäller brott 2016–2022.',
      'Share of the population aged 16–84 who say they were victims of the crime in the year before the survey. The answers cover crimes in 2016–2022.',
    )}
  </p>
  <Victims rows={ntu} lang={lang} />
  <Fragment slot="note">
    {L(
      `Svaren kommer från en enkät och gäller även brott som aldrig anmälts. Utländsk bakgrund betyder här att personen själv eller en eller båda föräldrarna är födda utomlands, till skillnad från kapitel ${chapter('kap1').num} och ${chapter('kap2').num}. Inte justerat för ålder eller andra skillnader. Skillnader på några tiondels procentenheter kan bero på slumpen, felmarginaler och resultat efter världsdel finns i tabellerna.`,
      `The answers come from a survey and include crimes that were never reported. A foreign background here means that the person or one or both parents were born abroad, unlike chapters ${chapter('kap1').num} and ${chapter('kap2').num}. Not adjusted for age or other differences. Differences of a few tenths of a percentage point can be due to chance; margins of error and results by world region are in the tables.`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2024-05-21-utsatthet-for-brott-bland-personer-med-utlandsk-bakgrund">{L('Brå, NTU Kortanalys 2/2024', 'Brå, NTU Kortanalys 2/2024')}</a>{L(
      ', Utsatthet för brott bland personer med utländsk bakgrund, tabellbilaga (tabell 1C–9B). Nationella trygghetsundersökningen 2017–2023, personer 16–84 år.',
      ', Utsatthet för brott bland personer med utländsk bakgrund (victimisation among people with a foreign background), table appendix (tables 1C–9B). Swedish Crime Survey 2017–2023, people aged 16–84.',
    )}
  </Fragment>
</Chapter>
