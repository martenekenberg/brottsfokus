---
// Chapter 2: birth region 2015–2018, and Brå's comparison with other factors.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import BarChart from '../charts/BarChart.astro';
import SubChart from '../SubChart.astro';
import OriginDots from '../kap2/OriginDots.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { chapter } from '../../lib/chapters';
import { loadOrigin, loadSuspectsByBackground, loadTableB6, loadRiskFactors } from '../../lib/data';
import { tablePage } from '../../lib/dataPages';
import { formatNumber } from '../../lib/format';
import { buildKap2Data, smallestGroup } from '../../lib/chapters/kap2';
import { buildFactorsSpec, buildRiskFactors } from '../../lib/chapters/kap2Factors';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n0 = (v: number) => formatNumber(v, 0, lang);
const n1 = (v: number) => formatNumber(v, 1, lang);

const tableB6 = loadTableB6();

const suspects = loadSuspectsByBackground();

// Chapter 2 uses the same crime list, so its menu is indented the same way.
const depthByOrder = new Map(suspects.map((r) => [r.crimeOrder, r.depth]));

const kap2Origin = loadOrigin();
const kap2Data = buildKap2Data(kap2Origin, depthByOrder, tableB6);

// Smallest groups in chapter 2, for the note under the chart.
const smallestCountry = smallestGroup(kap2Data, 'land');
const smallestMotherRegion = smallestGroup(kap2Data, 'moder');
if (!smallestCountry || !smallestMotherRegion) throw new Error('Chapter 2: group sizes missing');

// The headline says people born in Africa and Central Asia were suspected 4–6 times as often, and people born in
// the Nordic countries and Western Europe barely more often. Stop the build if Brå's risks no longer say so.
const regionRisk = (unit: string) => {
  const r = kap2Origin.find((x) => x.view === 'region' && x.crimeOrder === 0 && x.unit === unit);
  if (!r) throw new Error(`Chapter 2: no birth region ${unit}`);
  return r.risk;
};
const highRegions = ['Nordafrika', 'Östafrika', 'Övriga Afrika', 'Centralasien'].map(regionRisk);
const lowRegions = ['Norden utom Sverige', 'EU15 och Västeuropa utom Norden'].map(regionRisk);
if (!highRegions.every((r) => r >= 4 && r <= 6) || !lowRegions.every((r) => r > 1 && r < 1.15)) {
  throw new Error('Chapter 2 headline no longer matches the data');
}
const smallestN = Math.min(smallestCountry.n, smallestMotherRegion.n);

// ---------- Chapter 2, second chart: background next to other factors ----------
const riskFactorRows = loadRiskFactors();
const factors = buildRiskFactors(riskFactorRows, tableB6);
const factorsSpec = buildFactorsSpec(factors, lang);
// The headline names exactly these three factors. Stop the build if the data file holds others.
if (riskFactorRows.map((f) => f.factorId).sort().join('|') !== 'forsorjningsstod|kon|utbildning') {
  throw new Error('Chapter 2 second chart: headline no longer matches the data');
}
const factorRisk = (id: string) => {
  const f = riskFactorRows.find((r) => r.factorId === id);
  if (!f) throw new Error(`Chapter 2 second chart: no risk factor ${id}`);
  return n1(f.risk);
};

---

<Chapter
  id="kap2"
  lang={lang}
  tableHref={tablePage('kap2', lang).path}
  title={L(
    'Födda i Afrika och Centralasien misstänktes 4–6 gånger så ofta, födda i Norden och Västeuropa knappt oftare',
    'People born in Africa and Central Asia were suspected 4–6 times as often, those born in the Nordic countries and Western Europe barely more often',
  )}
>
  <p slot="intro">
    {L(
      'Hur många gånger vanligare det var att misstänkas för brott någon gång 2015–2018, jämfört med inrikesfödda med två inrikesfödda föräldrar. Utrikesfödda efter födelseområde eller land, barn till två invandrare efter moderns födelseområde.',
      'How many times more likely it was to be suspected of crime at some point in 2015–2018, compared with people born in Sweden with two Swedish-born parents. People born abroad by birth region or country, children of two immigrants by their mother’s birth region.',
    )}
  </p>
  <OriginDots data={kap2Data} lang={lang} />
  <Fragment slot="note">
    {L(
      `Misstänkt är inte dömd. Orange punkt är Brås beräkning om gruppen haft samma ålder, kön, inkomst och utbildning som jämförelsegruppen, inte en faktisk andel. Alla som misstänktes någon gång under fyra år räknas, så talen är högre än i kapitel ${chapter('kap1').num}. Vissa grupper är små, ner till ${n0(smallestN)} personer.`,
      `Suspected is not convicted. The orange dot is Brå’s calculation of the group with the same age, sex, income and education as the comparison group, not an actual share. Everyone suspected at some point in four years is counted, so the figures are higher than in chapter ${chapter('kap1').num}. Some groups are small, down to ${n0(smallestN)} people.`,
    )}
  </Fragment>
  <Fragment slot="source">
    {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund">{L('Brå rapport 2021:9', 'Brå report 2021:9')}</a>{L(
      ', tabellbilaga 1 (andelar av misstänkta och befolkningen: tabell B6). Folkbokförda 15 år och äldre den 31 december 2014, misstänkta för brott begångna 2015–2018.',
      ', table appendix 1 (shares of suspects and population: table B6). Registered residents aged 15 and over on 31 December 2014, suspected of crimes committed in 2015–2018.',
    )}
  </Fragment>
  <SubChart
    slot="after"
    id="kap2-faktorer"
    lang={lang}
    title={L(
      'Brå jämför bakgrund med försörjningsstöd, utbildning och kön',
      'Brå compares background with social assistance, education and sex',
    )}
  >
    <Fragment slot="intro">
      {L(
        `Brå gör jämförelsen i samma rapport för att sätta siffrorna i perspektiv. Under 2015–2018 var överrisken ${factorRisk('forsorjningsstod')} om familjen fick försörjningsstöd, ${factorRisk('utbildning')} med endast förgymnasial utbildning och ${factorRisk('kon')} för män jämfört med kvinnor.`,
        `Brå makes the comparison in the same report to put the figures in perspective. In 2015–2018 the excess risk was ${factorRisk('forsorjningsstod')} if the family received social assistance, ${factorRisk('utbildning')} with only compulsory education and ${factorRisk('kon')} for men compared with women.`,
      )}
    </Fragment>
    <ul slot="legend" class="legend-list" aria-label={L('Förklaring', 'Key')}>
      <li>
        <span class="mark bar-swatch" style="background:#1D4E89" aria-hidden="true"></span>{L(
          'Bakgrund, jämfört med inrikesfödda med två inrikesfödda föräldrar',
          'Background, compared with born in Sweden with two Swedish-born parents',
        )}
      </li>
      <li>
        <span class="mark bar-swatch" style="background:#C2410C" aria-hidden="true"></span>{L(
          'Annan faktor, jämfört med motsatt grupp (se Läs så här)',
          'Other factor, compared with the opposite group (see How to read this)',
        )}
      </li>
    </ul>
    <BarChart spec={factorsSpec} />
    <Fragment slot="note">
      {L(
        'Jämförelserna: försörjningsstöd någon gång 2014 mot inte, endast förgymnasial utbildning mot minst tre års eftergymnasial, män mot kvinnor. Varje faktor är mätt för sig, och faktorerna hänger ihop, så de kan inte läggas ihop. Ingen siffra är justerad för ålder.',
        'The comparisons: social assistance at some point in 2014 against none, compulsory school only against at least three years of higher education, men against women. Each factor is measured on its own, and the factors are linked, so they cannot be added together. None of the figures is adjusted for age.',
      )}
    </Fragment>
    <Fragment slot="source">
      {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund">{L('Brå rapport 2021:9', 'Brå report 2021:9')}</a>{L(
        '. Bakgrund: tabellbilaga 1, tabell B6. Försörjningsstöd, utbildning och kön: rapportens text, s. 54–55.',
        '. Background: table appendix 1, table B6. Social assistance, education and sex: the text of the report, p. 54–55.',
      )}
    </Fragment>
  </SubChart>
</Chapter>
