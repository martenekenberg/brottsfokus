---
// Chapter 1: suspects over time 2007–2018, and each group's share of all registered suspicions.
// Loads its own data and stops the build if its headline no longer matches the data.
import Chapter from '../Chapter.astro';
import Legend from '../Legend.astro';
import LineChart from '../charts/LineChart.astro';
import SubChart from '../SubChart.astro';
import SuspectsOverTime from '../kap1/SuspectsOverTime.astro';
import { tr, type BaseLang as Lang } from '../../lib/i18n';
import { loadSuspectsByBackground, loadTableB6, loadSuspicionShares } from '../../lib/data';
import { round } from '../../lib/calc';
import { tablePage } from '../../lib/dataPages';
import { formatNumber, formatPct } from '../../lib/format';
import { buildKap1Data, allGroupsFell, crimeById } from '../../lib/chapters/kap1';
import { buildSharesSpec, buildSuspicionShares, peakYear as sharePeakYear, shareGroup } from '../../lib/chapters/kap1Shares';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (sv: string, en: string) => tr(lang, sv, en);
const n1 = (v: number) => formatNumber(v, 1, lang);

const tableB6 = loadTableB6();

const suspects = loadSuspectsByBackground();

const kap1Data = buildKap1Data(suspects);

const kap1First = kap1Data.years[0];
const kap1Last = kap1Data.years[kap1Data.years.length - 1];
// The intro says the share fell in all four groups.
if (!allGroupsFell(kap1Data, 'c00')) throw new Error('Chapter 1 intro no longer matches the data');

// Intro: the range across the four groups, all crimes, first and last year. The sentence says two Swedish-born
// parents is the lowest and two foreign-born parents the highest; stop the build if that no longer holds.
const total = crimeById(kap1Data, 'c00').values;
const at = (g: 'sv2' | 'sv1' | 'u2' | 'utr', i: number) => {
  const v = total[g][i];
  if (v == null) throw new Error(`Chapter 1: no value for ${g}, ${kap1Data.years[i]}`);
  return v;
};
const lastI = kap1Data.years.length - 1;
for (const i of [0, lastI]) {
  const vals = (['sv2', 'sv1', 'u2', 'utr'] as const).map((g) => at(g, i));
  if (at('sv2', i) !== Math.min(...vals) || at('u2', i) !== Math.max(...vals)) {
    throw new Error('Chapter 1 intro: lowest and highest group no longer match the data');
  }
}

// The headline says people born in Sweden with two foreign-born parents were suspected more than three times
// as often as those with two Swedish-born parents, every year. Stop the build if any year falls to 3 or below.
if (!kap1Data.years.every((_, i) => at('u2', i) / at('sv2', i) > 3)) throw new Error('Chapter 1 headline no longer matches the data');

// ---------- Chapter 1, second chart: shares of all registered suspicions ----------
const shares = buildSuspicionShares(loadSuspicionShares());
const sharesSpec = buildSharesSpec(shares, lang);
const sharesFirst = shares.years[0];
const sharesLast = shares.years[shares.years.length - 1];
const ej = shareGroup(shares, 'ej');
const ejFirst = round(ej.shares[0], 1);
const ejLast = round(ej.shares[ej.shares.length - 1], 1);
const ejPeakYear = sharePeakYear(shares, 'ej');
const ejPeak = round(ej.shares[shares.years.indexOf(ejPeakYear)], 1);
// Population shares on 31 December 2014 (table B6), as the comparison in the note.
const b6Pop = (unit: string) => {
  const r = tableB6.find((x) => x.view === 'bakgrund' && x.unit === unit);
  if (!r) throw new Error(`Table B6: ${unit} missing`);
  return formatPct(r.populationPct, 1, lang);
};
---

<Chapter
  id="kap1"
  lang={lang}
  tableHref={tablePage('kap1', lang).path}
  title={L(
    `Barn till två invandrare misstänktes mer än tre gånger så ofta, varje år ${kap1First}–${kap1Last}`,
    `Children of two immigrants were suspected more than three times as often, every year from ${kap1First} to ${kap1Last}`,
  )}
>
  <p slot="intro">
    {L(
      `Misstänkta för minst ett brott under året, per 1 000 invånare 15 år och äldre. År ${kap1Last}: ${n1(at('u2', lastI))} bland inrikesfödda med två utrikesfödda föräldrar, ${n1(at('sv2', lastI))} bland dem med två inrikesfödda föräldrar. Andelen minskade i alla grupper från ${kap1First}, men avståndet mellan dem fanns kvar.`,
      `Suspected of at least one crime during the year, per 1,000 residents aged 15 and over. In ${kap1Last}: ${n1(at('u2', lastI))} among people born in Sweden with two foreign-born parents, ${n1(at('sv2', lastI))} among those with two Swedish-born parents. The share fell in every group from ${kap1First}, but the gap between them remained.`,
    )}
  </p>
  <SuspectsOverTime data={kap1Data} lang={lang} />
  <Fragment slot="note">
    {L(
      'Misstänkt är inte dömd. Inte justerat för ålder eller kön, och grupperna med utländsk bakgrund har fler unga, som oftare misstänks. Med hänsyn till ålder, kön, inkomst, utbildning och kommuntyp blir skillnaderna mindre, men de finns kvar. Rubriken gäller brott totalt. Övergrepp i rättssak saknas 2007–2008.',
      'Suspected is not convicted. Not adjusted for age or sex, and the groups with a foreign background have more young people, who are more often suspected. Taking age, sex, income, education and type of municipality into account makes the differences smaller, but they remain. The headline is about all crimes together. Interference in a judicial matter is missing for 2007–2008.',
    )}
  </Fragment>
  <Fragment slot="source">
    {L(
      'Källa: Brå rapport 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund. Folkbokförda personer 15 år och äldre.',
      'Source: Brå report 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund (suspects of crime by Swedish and foreign background). Registered residents aged 15 and over.',
    )}
  </Fragment>
  <SubChart
    slot="after"
    id="kap1-misstankar"
    lang={lang}
    title={L(
      `Personer som inte är folkbokförda i Sverige stod för ${n1(ejLast)} procent av brottsmisstankarna ${sharesLast}, mot ${n1(ejFirst)} procent ${sharesFirst}`,
      `People not registered as living in Sweden accounted for ${n1(ejLast)}% of crime suspicions in ${sharesLast}, against ${n1(ejFirst)}% in ${sharesFirst}`,
    )}
  >
    <Fragment slot="intro">
      {L(
        'Varje grupps andel av alla registrerade brottsmisstankar under året, även misstankar mot personer som inte bor här. Här räknas misstankar, inte personer: en person kan misstänkas för flera brott.',
        'Each group’s share of all crime suspicions registered during the year, including suspicions against people who do not live here. Suspicions are counted, not people: one person can be suspected of several crimes.',
      )}
    </Fragment>
    <Legend
      slot="legend"
      items={sharesSpec.series.map((s) => ({ label: s.label, color: s.color, mark: 'line' as const }))}
    />
    <LineChart spec={sharesSpec} />
    <Fragment slot="note">
      {L(
        `Icke folkbokförda vistas tillfälligt i Sverige. Hit räknas också misstankar där folkbokföringen inte gått att avgöra, till exempel för att personnumret är ofullständigt. Deras andel var högst ${ejPeakYear}, ${n1(ejPeak)} procent. De finns inte i befolkningsstatistiken och kan inte jämföras med befolkningen. Som jämförelse för de övriga, befolkningen 15 år och äldre 2014: ${b6Pop('Inrikesfödda med två inrikesfödda föräldrar')} inrikesfödda med två inrikesfödda föräldrar, ${b6Pop('Utrikesfödda')} utrikesfödda, ${b6Pop('Inrikesfödda med två utrikesfödda föräldrar')} inrikesfödda med två utrikesfödda föräldrar och ${b6Pop('Inrikesfödda med en inrikes- och en utrikesfödd förälder')} med en utrikesfödd förälder. Inte justerat för ålder eller kön.`,
        `People not registered are staying in Sweden temporarily. The group also includes suspicions where registration could not be determined, for example because the personal identity number is incomplete. Their share was highest in ${ejPeakYear}, at ${n1(ejPeak)}%. They are not in the population statistics and cannot be compared with the population. As a comparison for the others, the population aged 15 and over in 2014: ${b6Pop('Inrikesfödda med två inrikesfödda föräldrar')} born in Sweden with two Swedish-born parents, ${b6Pop('Utrikesfödda')} born abroad, ${b6Pop('Inrikesfödda med två utrikesfödda föräldrar')} born in Sweden with two foreign-born parents and ${b6Pop('Inrikesfödda med en inrikes- och en utrikesfödd förälder')} with one foreign-born parent. Not adjusted for age or sex.`,
      )}
    </Fragment>
    <Fragment slot="source">
      {L('Källa: ', 'Source: ')}<a href="https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund">{L('Brå rapport 2021:9', 'Brå report 2021:9')}</a>{L(
        ', tabellbilaga 3 (tabell D1 och D2): alla registrerade brottsmisstankar per år, efter om den misstänkta var folkbokförd vid brottet. Befolkningens andelar: tabellbilaga 1, tabell B6.',
        ', table appendix 3 (tables D1 and D2): all registered crime suspicions per year, by whether the suspect was registered as living in Sweden at the time of the crime. Population shares: table appendix 1, table B6.',
      )}
    </Fragment>
  </SubChart>
</Chapter>
