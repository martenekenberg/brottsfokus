---
export interface KeyFigure {
  value: string;
  unit: string;
  text: string;
  source: string;
}

interface Props {
  figures: KeyFigure[];
}

const { figures } = Astro.props;
---

<section class="key-figures" aria-label="Siffror i korthet">
  {
    figures.map((f) => (
      <div class="figure">
        <p class="value">
          {f.value}
          <span class="unit">{f.unit}</span>
        </p>
        <p class="text">{f.text}</p>
        <p class="src">{f.source}</p>
      </div>
    ))
  }
</section>

<style>
  .key-figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    padding: 48px 0 64px;
  }
  .figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  p {
    margin: 0;
  }
  .value {
    font-family: var(--font-serif);
    font-size: 56px;
    line-height: 1;
    font-weight: 500;
    color: var(--focus);
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-size: 28px;
  }
  .text {
    font-size: 15px;
    line-height: 1.5;
  }
  .src {
    font-size: 12px;
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .key-figures {
      gap: 24px;
      padding: 24px 0 40px;
    }
  }
</style>
