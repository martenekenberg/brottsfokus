---
import { tablesIndexPath } from '../lib/dataPages';
import { tr, type Lang } from '../lib/i18n';

const terms = (lang: Lang) => [
  {
    title: tr(lang, 'Misstänkt, inte dömd', 'Suspected, not convicted'),
    text: tr(
      lang,
      'De flesta diagram bygger på personer som polis eller åklagare bedömt som skäligen misstänkta. Det är inte samma sak som en fällande dom.',
      'Most charts are based on people whom the police or a prosecutor have judged to be reasonably suspected of a crime. This is not the same as a conviction.',
    ),
  },
  {
    title: tr(lang, 'Bakgrund', 'Background'),
    text: tr(
      lang,
      'Utrikesfödd är född utomlands. Inrikesfödda delas in efter om ingen, en eller båda föräldrarna är födda utomlands.',
      'Born abroad means born outside Sweden. People born in Sweden are grouped by whether none, one or both of their parents were born abroad.',
    ),
  },
  {
    title: tr(lang, 'Medborgarskap', 'Citizenship'),
    text: tr(
      lang,
      'Kriminalvårdens statistik redovisar bara svenskt eller utländskt medborgarskap, inte födelseland eller vilket land.',
      'The prison service statistics show only Swedish or foreign citizenship, not country of birth or which country.',
    ),
  },
  {
    title: tr(lang, 'Överrisk', 'Excess risk'),
    text: tr(
      lang,
      'Hur många gånger vanligare det är att misstänkas i en grupp än bland inrikesfödda med två inrikesfödda föräldrar. En överrisk på 2,0 betyder dubbelt så vanligt.',
      'How many times more likely it is to be suspected in a group than among people born in Sweden with two Swedish-born parents. An excess risk of 2.0 means twice as likely.',
    ),
  },
  {
    title: tr(lang, 'Jämförelse med befolkningen', 'Comparison with the population'),
    text: tr(
      lang,
      'Där det går visas gruppens andel bredvid dess andel av befolkningen enligt SCB eller Brås egna befolkningsuppgifter.',
      'Where possible, a group’s share is shown next to its share of the population, according to SCB or Brå’s own population figures.',
    ),
  },
];
const sources = [
  {
    label: 'Brå rapport 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund',
    url: 'https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund',
  },
  {
    label: 'Brå rapport 2005:17, Brottslighet bland personer födda i Sverige och i utlandet',
    url: 'https://www.bra.se/download/18.cba82f7130f475a2f1800012697/2005_17_brottslighet_bland_personer_fodda_sverige_och_utlandet.pdf',
  },
  {
    label: 'Khoshnood m.fl. 2021, Forensic Sciences Research',
    url: 'https://doi.org/10.1080/20961790.2020.1868681',
  },
  {
    label: 'Khoshnood m.fl. 2026, Journal of Interpersonal Violence',
    url: 'https://lup.lub.lu.se/record/d9a9d1f6-f428-4b57-abf2-5e0e9c7b84f5',
  },
  {
    label: 'SCB, Sveriges befolkning i sammandrag 1960–2025',
    url: 'https://www.scb.se/hitta-statistik/statistik-efter-amne/befolkning-och-levnadsforhallanden/befolkningens-sammansattning-och-utveckling/befolkningsstatistik/pong/tabell-och-diagram/sveriges-befolkning-i-sammandrag-1960-2025-korrigerad-2026-06-18/',
  },
  {
    label: 'SCB, Utländska medborgare i Sverige',
    url: 'https://www.scb.se/hitta-statistik/sverige-i-siffror/manniskorna-i-sverige/utlandska-medborgare-i-sverige/',
  },
];

interface Props {
  /** Extra sources, e.g. Brå's yearly prison reports, read from the data files. */
  extraSources?: { label: string; url: string }[];
  lang: Lang;
}
const { extraSources = [], lang } = Astro.props;
const allSources = [...sources, ...extraSources];
---
<section id="metod" class="method" aria-labelledby="metod-h">
  <h2 id="metod-h">{tr(lang, 'Metod och begrepp', 'Method and terms')}</h2>
  {
    terms(lang).map((t) => (
      <div class="term">
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </div>
    ))
  }
  <div class="sources">
    <h3>{tr(lang, 'Källor', 'Sources')}</h3>
    <p>
      {tr(lang, 'Siffror i tabellform och som CSV-filer finns under ', 'Figures as tables and CSV files are under ')}
      <a href={tablesIndexPath(lang)}>{tr(lang, 'Tabeller', 'Tables')}</a>.
    </p>
    <ul>
      {
        allSources.map((s) => (
          <li>
            <a href={s.url}>{s.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .method {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    padding: 64px 0;
    border-top: 3px solid var(--ink);
    scroll-margin-top: calc(var(--sticky-nav-h) + 8px);
  }
  h2 {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
  }
  .term {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-body);
  }
  .sources {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.6;
    columns: 2 360px;
    column-gap: 32px;
  }
  li {
    break-inside: avoid;
    padding: 2px 0;
  }
  @media (max-width: 640px) {
    .method {
      gap: 24px;
      padding: 40px 0;
    }
  }
</style>
