---
import { tablesIndexPath } from '../lib/dataPages';
import { chapter } from '../lib/chapters';
import GroupingsTable from './GroupingsTable.astro';
import { tr, type BaseLang as Lang } from '../lib/i18n';

const terms = (lang: Lang) => [
  {
    id: 'misstankt',
    title: tr(lang, 'Misstänkt, inte dömd', 'Suspected, not convicted'),
    text: tr(
      lang,
      'Misstänkt betyder att polis eller åklagare bedömt personen som skäligen misstänkt för brott. Det är inte en fällande dom.',
      'Suspected means that the police or a prosecutor judged the person to be reasonably suspected of a crime. It is not a conviction.',
    ),
  },
  {
    id: 'bakgrund',
    title: tr(lang, 'Bakgrund', 'Background'),
    text: tr(
      lang,
      `Utrikesfödd är född utomlands. Inrikesfödda delas in efter om ingen, en eller båda föräldrarna är födda utomlands. Källorna gör olika indelningar, se tabellen nedan.`,
      `Born abroad means born outside Sweden. People born in Sweden are grouped by whether none, one or both of their parents were born abroad. The sources group people differently; see the table below.`,
    ),
  },
  {
    // Owner's decision, November 2026: the site may say "invandrare" in short answers, meaning born abroad only.
    id: 'invandrare',
    title: tr(lang, 'Invandrare', 'Immigrants'),
    text: tr(
      lang,
      'På Brottsfokus betyder invandrare utrikesfödda: personer födda i ett annat land och folkbokförda i Sverige. Ordet saknar officiell statistisk definition, och Brå och SCB skriver utrikesfödda. Barn till invandrare är födda i Sverige och räknas inte som invandrare. Barn till två invandrare betyder inrikesfödda med två utrikesfödda föräldrar.',
      'On Brottsfokus, immigrants means people born abroad: people born in another country and registered as living in Sweden. The word has no official statistical definition, and Brå and SCB write “utrikesfödda” (born abroad). Children of immigrants were born in Sweden and are not counted as immigrants. Children of two immigrants means people born in Sweden with two foreign-born parents.',
    ),
  },
  {
    id: 'folkbokford',
    title: tr(lang, 'Folkbokförd', 'Registered as living in Sweden'),
    text: tr(
      lang,
      'Registrerad hos Skatteverket som stadigvarande boende i Sverige. Befolkningsstatistiken räknar bara folkbokförda. Personer på tillfälligt besök är inte folkbokförda.',
      'Registered with the Swedish Tax Agency as living permanently in Sweden. The population statistics count only registered residents. People on a temporary stay are not registered.',
    ),
  },
  {
    id: 'medborgarskap',
    title: tr(lang, 'Medborgarskap', 'Citizenship'),
    text: tr(
      lang,
      'Fängelsestatistiken skiljer bara på svenskt och utländskt medborgarskap. Den visar inte födelseland eller vilket land.',
      'The prison statistics only separate Swedish from foreign citizenship. They do not show country of birth or which country.',
    ),
  },
  {
    id: 'utsatt',
    title: tr(lang, 'Utsatt för brott', 'Victim of crime'),
    text: tr(
      lang,
      `Kapitel ${chapter('kap6').num} bygger på Brås Nationella trygghetsundersökning (NTU), en årlig enkät där personer 16–84 år svarar på om de utsatts för brott. Den fångar även brott som inte anmäls.`,
      `Chapter ${chapter('kap6').num} is based on Brå’s Swedish Crime Survey (NTU), a yearly survey in which people aged 16–84 say whether they have been victims of crime. It also captures crimes that are not reported.`,
    ),
  },
  {
    id: 'overrisk',
    title: tr(lang, 'Överrisk', 'Excess risk'),
    text: tr(
      lang,
      'Hur många gånger vanligare något är i en grupp än i jämförelsegruppen, oftast inrikesfödda med två inrikesfödda föräldrar. En överrisk på 2,0 betyder dubbelt så vanligt.',
      'How many times more common something is in a group than in the comparison group, most often people born in Sweden with two Swedish-born parents. An excess risk of 2.0 means twice as common.',
    ),
  },
  {
    id: 'befolkningen',
    title: tr(lang, 'Jämförelse med befolkningen', 'Comparison with the population'),
    text: tr(
      lang,
      'Där det går visas gruppens andel bredvid dess andel av befolkningen enligt SCB eller Brås egna befolkningsuppgifter.',
      'Where possible, a group’s share is shown next to its share of the population, according to SCB or Brå’s own population figures.',
    ),
  },
  {
    // Part 5 (Denmark), added November 2026. Danmarks Statistik's own groups, in its own words.
    id: 'ursprung-dk',
    title: tr(lang, 'Ursprung i Danmark', 'Origin in Denmark'),
    text: tr(
      lang,
      `Kapitel ${chapter('kap11').num} använder Danmarks Statistiks grupper. Invandrare är födda utomlands, och ingen förälder är både dansk medborgare och född i Danmark. Barn till invandrare (efterkommere) är födda i Danmark, och ingen förälder är både dansk medborgare och född i Danmark. Alla andra har dansk ursprung, även den som har en utrikesfödd förälder. Västliga länder är EU, Norden, Storbritannien, Schweiz, USA, Kanada, Australien och Nya Zeeland med några småstater. Övriga är icke-västliga.`,
      `Chapter ${chapter('kap11').num} uses Danmarks Statistik’s groups. Immigrants were born abroad, and neither parent is both a Danish citizen and born in Denmark. Descendants (efterkommere) were born in Denmark, and neither parent is both a Danish citizen and born in Denmark. Everyone else is of Danish origin, including people with one foreign-born parent. Western countries are the EU, the Nordic countries, the United Kingdom, Switzerland, the United States, Canada, Australia and New Zealand, with a few small states. All others are non-Western.`,
    ),
  },
  {
    id: 'index-dk',
    title: tr(lang, 'Kriminalitetsindex', 'Crime index'),
    text: tr(
      lang,
      `Danmarks Statistiks mått i kapitel ${chapter('kap12').num}. Genomsnittet för alla män, eller alla kvinnor, 15–79 år är 100. Ett index på 245 betyder att gruppen lagfördes 2,45 gånger så ofta som genomsnittet. Justerat för ålder betyder att Danmarks Statistik räknar som om gruppen hade samma åldrar som befolkningen.`,
      `Danmarks Statistik’s measure in chapter ${chapter('kap12').num}. The average for all men, or all women, aged 15–79 is 100. An index of 245 means the group was convicted 2.45 times as often as average. Adjusted for age means Danmarks Statistik calculates as if the group had the same ages as the population.`,
    ),
  },
  {
    id: 'lagford-dk',
    title: tr(lang, 'Lagförd i Danmark', 'Convicted in Denmark'),
    text: tr(
      lang,
      'Danmarks Statistik räknar personer som under året fått en fällande dom, böter eller ett beslut att avstå från åtal. Bara personer som bodde i Danmark den 1 januari eller den 31 december räknas, så turister och asylsökande utan dansk folkbokföring finns inte med.',
      'Danmarks Statistik counts people who during the year received a guilty verdict, a fine or a decision to waive prosecution. Only people who lived in Denmark on 1 January or 31 December are counted, so tourists and asylum seekers without a Danish registration are not included.',
    ),
  },
  {
    // Part 6 (Finland), added November 2026. Statistics Finland's own groups, in its own words.
    id: 'bakgrund-fi',
    title: tr(lang, 'Bakgrund i Finland', 'Origin in Finland'),
    text: tr(
      lang,
      `Kapitel ${chapter('kap13').num} och ${chapter('kap14').num} använder Statistikcentralens grupper. Utländsk bakgrund betyder att båda föräldrarna, eller den enda kända föräldern, är födda utomlands. Alla andra har finländsk bakgrund, även den som har en förälder född utomlands. Båda grupperna delas upp efter om personen själv är född i Finland eller utomlands. Det liknar Brås indelning i inrikes- och utrikesfödda med två utrikesfödda föräldrar.`,
      `Chapters ${chapter('kap13').num} and ${chapter('kap14').num} use Statistics Finland’s groups. A foreign background means that both parents, or the only known parent, were born abroad. Everyone else has a Finnish background, including people with one parent born abroad. Both groups are split by whether the person was born in Finland or abroad. This is close to Brå’s grouping of people born in Sweden or abroad with two foreign-born parents.`,
    ),
  },
  {
    id: 'misstankt-fi',
    title: tr(lang, 'Misstänkt i Finland', 'Suspected in Finland'),
    text: tr(
      lang,
      'Statistikcentralen räknar personer som polisen misstänker för ett brott som har klarats upp. Varje person räknas en gång per år, efter sitt allvarligaste brott, och bara personer med finsk personbeteckning räknas. Asylsökande ingår inte i befolkningen. Talen per invånare är Statistikcentralens egna.',
      'Statistics Finland counts people the police suspect of an offence that has been solved. Each person is counted once a year, by their most serious offence, and only people with a Finnish personal identity code are counted. Asylum seekers are not part of the population. The rates per resident are Statistics Finland’s own.',
    ),
  },
  {
    // Part 7 (Norway), added November 2026. SSB's own terms.
    id: 'siktet-no',
    title: tr(lang, 'Misstänkt (siktad) i Norge', 'Charged in Norway'),
    text: tr(
      lang,
      `Kapitel ${chapter('kap15').num} och ${chapter('kap16').num} räknar siktade personer: de som polisen eller åklagaren i sitt slutliga beslut anser har begått ett lovbrott. Det är inte en dom. Alla lovbrott räknas, även trafikbrott, och varje person räknas en gång per år. SSB redovisar ett årligt genomsnitt för 2021–2023.`,
      `Chapters ${chapter('kap15').num} and ${chapter('kap16').num} count people charged: those the police or prosecution, in their final decision, find to have committed an offence. It is not a conviction. All offences are counted, including traffic offences, and each person is counted once a year. Statistics Norway reports a yearly average for 2021–2023.`,
    ),
  },
  {
    id: 'bakgrunn-no',
    title: tr(lang, 'Invandringsbakgrund i Norge', 'Immigrant background in Norway'),
    text: tr(
      lang,
      'SSB:s grupper. Invandrare är födda utomlands med två föräldrar födda utomlands. Barn till två invandrare (norskfødte med innvandrerforeldre) är födda i Norge med två föräldrar födda utomlands. Övriga befolkningen är alla andra som bor i Norge, också den som har en förälder född utomlands, och är jämförelsegruppen. Det liknar Brås indelning, men Brå jämför oftast med hela befolkningen.',
      'Statistics Norway’s groups. Immigrants were born abroad to two parents born abroad. The Norwegian-born to immigrant parents (norskfødte med innvandrerforeldre) were born in Norway to two parents born abroad. The rest of the population is everyone else living in Norway, including people with one parent born abroad, and is the comparison group. This is close to Brå’s grouping, but Brå usually compares with the whole population.',
    ),
  },
];
const sources = [
  {
    label: 'Brå rapport 2021:9, Misstänkta för brott bland personer med inrikes respektive utrikes bakgrund',
    url: 'https://bra.se/rapporter/arkiv/2021-08-25-misstankta-for-brott-bland-personer-med-inrikes-respektive-utrikes-bakgrund',
  },
  {
    label: 'Brå, NTU Kortanalys 2/2024, Utsatthet för brott bland personer med utländsk bakgrund',
    url: 'https://bra.se/rapporter/arkiv/2024-05-21-utsatthet-for-brott-bland-personer-med-utlandsk-bakgrund',
  },
  {
    label: 'Brå rapport 2026:15, Utvisningsdömda i brottmål',
    url: 'https://bra.se/download/18.5d0a8fbf19ddcaf2a6cccb2/1777972068717/2026_15_Utvisningsd%C3%B6mda%20i%20brottm%C3%A5l.pdf',
  },
  {
    label: 'Brå rapport 2025:5, Offer och gärningspersoner vid dödligt våld',
    url: 'https://bra.se/rapporter/arkiv/2025-03-25-offer-och-garningspersoner-vid-dodligt-vald',
  },
  {
    label: 'Bäckman m.fl. 2021, Criminal convictions and immigrant background 1973–2017 in Sweden, Nordic Journal of Criminology',
    url: 'https://doi.org/10.1080/2578983X.2021.1900038',
  },
  {
    label: 'Brå rapport 2025:21, Födelsekohortstatistik',
    url: 'https://bra.se/rapporter/arkiv/2025-12-02-fodelsekohortstatistik',
  },
  {
    label: 'Brå rapport 2005:17, Brottslighet bland personer födda i Sverige och i utlandet',
    url: 'https://www.bra.se/download/18.cba82f7130f475a2f1800012697/2005_17_brottslighet_bland_personer_fodda_sverige_och_utlandet.pdf',
  },
  {
    label: 'Khoshnood m.fl. 2021, Forensic Sciences Research',
    url: 'https://doi.org/10.1080/20961790.2020.1868681',
  },
  {
    label: 'Khoshnood m.fl. 2026, Journal of Interpersonal Violence',
    url: 'https://lup.lub.lu.se/record/d9a9d1f6-f428-4b57-abf2-5e0e9c7b84f5',
  },
  {
    label: 'SCB, Sveriges befolkning i sammandrag 1960–2025',
    url: 'https://www.scb.se/hitta-statistik/statistik-efter-amne/befolkning-och-levnadsforhallanden/befolkningens-sammansattning-och-utveckling/befolkningsstatistik/pong/tabell-och-diagram/sveriges-befolkning-i-sammandrag-1960-2025-korrigerad-2026-06-18/',
  },
  {
    label: 'Danmarks Statistik, Statistikbanken, tabell STRFNA10 (skyldige personer efter herkomst)',
    url: 'https://www.statistikbanken.dk/STRFNA10',
  },
  {
    label: 'Danmarks Statistik, Statistikbanken, tabell FOLK1E (befolkningen efter herkomst och ålder)',
    url: 'https://www.statistikbanken.dk/FOLK1E',
  },
  {
    label: 'Danmarks Statistik, Indvandrere i Danmark 2025',
    url: 'https://www.dst.dk/da/Statistik/udgivelser/VisPub?cid=54707',
  },
  {
    label: 'Statistikcentralen (Tilastokeskus), StatFin, tabell 13zk (misstänkta för brott efter bakgrund, kön och ålder)',
    url: 'https://pxdata.stat.fi/PxWeb/pxweb/sv/StatFin/StatFin__rpk/13zk.px/',
  },
  {
    label: 'SSB (Statistisk sentralbyrå), Siktelser og siktede personer etter innvandringsbakgrunn, tabell 3 (Excel)',
    url: 'https://www.ssb.no/sosiale-forhold-og-kriminalitet/kriminalitet-og-rettsvesen/statistikk/etterforskede-lovbrudd/artikler/siktelser-og-siktede-personer-etter-innvandringsbakgrunn',
  },
  {
    label: 'SCB, Utländska medborgare i Sverige',
    url: 'https://www.scb.se/hitta-statistik/sverige-i-siffror/manniskorna-i-sverige/utlandska-medborgare-i-sverige/',
  },
];

interface Props {
  /** Extra sources, e.g. Brå's yearly prison reports, read from the data files. */
  extraSources?: { label: string; url: string }[];
  lang: Lang;
  /** On its own page the page header carries the headline, so the section leaves its own out. */
  ownPage?: boolean;
}
const { extraSources = [], lang, ownPage = false } = Astro.props;
// Official titles stay as published; only the wording around them is translated.
const sourceLabel = (label: string) =>
  lang === 'en' ? label.replace(/^Brå rapport /, 'Brå report ').replace(' m.fl. ', ' et al. ') : label;
const allSources = [...sources, ...extraSources].map((s) => ({ ...s, label: sourceLabel(s.label) }));
---
<section id="metod" class:list={['method', { 'own-page': ownPage }]} aria-label={tr(lang, 'Metod och begrepp', 'Method and terms')}>
  {!ownPage && <h2 id="metod-h">{tr(lang, 'Metod och begrepp', 'Method and terms')}</h2>}
  {
    terms(lang).map((t) => (
      <div class="term" id={`begrepp-${t.id}`}>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </div>
    ))
  }
  <GroupingsTable lang={lang} />
  <div class="sources">
    <h3>{tr(lang, 'Källor', 'Sources')}</h3>
    <p>
      {tr(lang, 'Siffror i tabellform och som CSV-filer finns under ', 'Figures as tables and CSV files are under ')}
      <a href={tablesIndexPath(lang)}>{tr(lang, 'Tabeller', 'Tables')}</a>.
    </p>
    <ul>
      {
        allSources.map((s) => (
          <li>
            <a href={s.url}>{s.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .method {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    padding: 64px 0;
    border-top: 3px solid var(--ink);
    scroll-margin-top: calc(var(--sticky-nav-h) + 8px);
  }
  .method.own-page {
    padding-top: 32px;
    border-top: 1px solid var(--ink);
  }
  h2 {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 500;
  }
  .term {
    scroll-margin-top: calc(var(--sticky-nav-h) + 8px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-body);
  }
  .sources {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.6;
    columns: 2 360px;
    column-gap: 32px;
  }
  li {
    break-inside: avoid;
    padding: 2px 0;
  }
  @media (max-width: 640px) {
    .method {
      gap: 24px;
      padding: 40px 0;
    }
  }
</style>
