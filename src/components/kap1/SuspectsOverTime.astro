---
// Chapter 1 chart with its controls: crime type menu and view toggle.
// Without JavaScript the default view (brott totalt, per 1 000) is shown and the controls stay hidden.
import LineChart from '../charts/LineChart.astro';
import { buildKap1Spec, chartHeading, crimeById, GROUPS, type Kap1Data } from '../../lib/chapters/kap1';

interface Props {
  data: Kap1Data;
}

const { data } = Astro.props;
const defaultCrime = 'c00';
const spec = buildKap1Spec(data, defaultCrime, 'rate');
const heading = chartHeading(crimeById(data, defaultCrime), 'rate');
const indent = (depth: number) => '\u00a0\u00a0'.repeat(depth);

const legend = [
  { id: 'u2', modes: 'rate ratio' },
  { id: 'utr', modes: 'rate ratio' },
  { id: 'sv1', modes: 'rate ratio' },
  { id: 'sv2', modes: 'rate' },
  { id: 'tot', modes: 'rate' },
] as const;
---

<div class="chart-block" data-kap1>
  <div class="controls" data-controls hidden>
    <label class="crime">
      <span class="control-label">Brottstyp</span>
      <select data-crime>
        {
          data.crimes.map((c) => (
            <option value={c.id} selected={c.id === defaultCrime}>
              {indent(c.depth)}
              {c.name}
            </option>
          ))
        }
      </select>
    </label>
    <div class="toggle" role="group" aria-label="Visa som">
      <button type="button" data-mode="rate" aria-pressed="true">Per 1 000 invånare</button>
      <button type="button" data-mode="ratio" aria-pressed="false">Jämfört med två inrikesfödda föräldrar</button>
    </div>
  </div>

  <ul class="legend-list" aria-label="Förklaring">
    {
      legend.map((l) => (
        <li data-modes={l.modes}>
          <span
            class:list={['mark', GROUPS[l.id].dashed ? 'dash' : 'line']}
            style={`border-color:${GROUPS[l.id].color}`}
            aria-hidden="true"
          />
          {GROUPS[l.id].label}
        </li>
      ))
    }
    <li data-modes="ratio" hidden>
      <span class="mark dash" style="border-color:#121212" aria-hidden="true"></span>
      Inrikesfödda med två inrikesfödda föräldrar = 1
    </li>
  </ul>

  <p class="chart-heading" data-heading aria-live="polite">{heading}</p>
  <LineChart spec={spec} />
  <script type="application/json" data-kap1-data set:html={JSON.stringify(data)} />
</div>

<script>
  import { buildKap1Spec, chartHeading, crimeById, type Kap1Data, type Mode } from '../../lib/chapters/kap1';

  document.querySelectorAll<HTMLElement>('[data-kap1]').forEach((root) => {
    const data = JSON.parse(root.querySelector('[data-kap1-data]')?.textContent ?? '{}') as Kap1Data;
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const select = root.querySelector<HTMLSelectElement>('[data-crime]');
    const heading = root.querySelector<HTMLElement>('[data-heading]');
    const figure = root.querySelector<HTMLElement>('[data-line-chart]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    if (!controls || !select || !heading || !figure) return;

    controls.hidden = false;
    let mode: Mode = 'rate';

    const update = () => {
      const crime = crimeById(data, select.value);
      heading.textContent = chartHeading(crime, mode);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      root.querySelectorAll<HTMLElement>('[data-modes]').forEach((li) => {
        li.hidden = !(li.dataset.modes ?? '').split(' ').includes(mode);
      });
      figure.dispatchEvent(new CustomEvent('chart:update', { detail: buildKap1Spec(data, crime.id, mode) }));
    };

    select.addEventListener('change', update);
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as Mode;
        update();
      }),
    );
  });
</script>

