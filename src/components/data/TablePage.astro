---
// Shared frame for a table page: kicker, headline, summary, "Läs så här", tables,
// download, terms of use, sources, link back to the chart, links to the other
// table pages. Adds Dataset markup.
import DataLayout from '../../layouts/DataLayout.astro';
import DataTableView from './DataTableView.astro';
import { chapter } from '../../lib/chapters';
import { tablePage, tablePages, tablesIndexPath } from '../../lib/dataPages';
import { dataDate } from '../../lib/dataDates';
import { IN_LANGUAGE, localePath, tr, type Lang } from '../../lib/i18n';
import { site, absoluteUrl, dayMonthYear } from '../../lib/site';
import type { TablePageContent } from '../../lib/tablePageContent';

interface Props {
  content: TablePageContent;
}

const { content: p } = Astro.props;
const lang: Lang = p.lang;
const page = tablePage(p.chapterId, lang);
const c = chapter(p.chapterId);
const pageUrl = absoluteUrl(page.path);
// The page changes when its data changes, not on every deploy.
const updated = dataDate(p.dataFiles);

if (p.datasetDescription.length < 50) throw new Error(`${page.path}: dataset description is too short`);
const dataset = {
  '@type': 'Dataset',
  '@id': `${pageUrl}#dataset`,
  name: p.h1,
  description: p.datasetDescription,
  url: pageUrl,
  inLanguage: IN_LANGUAGE[lang],
  keywords: p.keywords,
  license: site.dataLicense.url,
  isAccessibleForFree: true,
  creditText: tr(lang, `${site.name}, efter uppgifter från ${p.credit}`, `${site.name}, based on data from ${p.credit}`),
  creator: { '@id': `${site.url}#publisher` },
  publisher: { '@id': `${site.url}#publisher` },
  isBasedOn: p.sources.map((s) => s.url),
  dateModified: updated,
  temporalCoverage: p.temporalCoverage,
  spatialCoverage: { '@type': 'Place', name: tr(lang, 'Sverige', 'Sweden') },
  variableMeasured: p.variableMeasured,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absoluteUrl(page.csvPath) },
    { '@type': 'DataDownload', encodingFormat: 'text/markdown', contentUrl: absoluteUrl(page.mdPath) },
  ],
};
const chartHref = `${localePath(lang, '/')}#${p.chapterId}`;
const crumbTables = tr(lang, 'Tabeller', 'Tables');
---

<DataLayout
  title={`${p.shortTitle} | ${site.name}`}
  description={p.description}
  path={page.path}
  updated={updated}
  markdownPath={page.mdPath}
  lang={lang}
  crumbs={[
    { name: crumbTables, path: tablesIndexPath(lang) },
    { name: page.name, path: page.path },
  ]}
  citations={p.sources.map((s) => s.url)}
  jsonLdNodes={[dataset]}
>
  <p class="kicker">{tr(lang, 'Tabell', 'Table')} · {c.num} {c.navLabel[lang]}</p>
  <h1>{p.h1}</h1>
  <p class="lead">{p.lead}</p>

  <div class="note">
    <strong>{tr(lang, 'Läs så här. ', 'How to read this. ')}</strong>
    {p.note}
  </div>

  {
    p.sections.map((s) => (
      <>
        {s.heading && <h2>{s.heading}</h2>}
        {(s.intro || s.collapsed) && (
          <p class="body">
            {
              [
                s.intro,
                s.collapsed ? tr(lang, 'Klicka på en brottstyp för att visa tabellen.', 'Click a crime type to show its table.') : '',
              ]
                .filter(Boolean)
                .join(' ')
            }
          </p>
        )}
        {s.collapsed ? (
          <div>
            {s.tables.map((t) => (
              <DataTableView table={t} collapsed lang={lang} />
            ))}
          </div>
        ) : (
          s.tables.map((t) => <DataTableView table={t} lang={lang} />)
        )}
        {s.after && <p class="body">{s.after}</p>}
      </>
    ))
  }

  <h2>{tr(lang, 'Ladda ner', 'Download')}</h2>
  <p class="body">
    <a href={page.csvPath} download>{tr(lang, 'Alla siffror på sidan som CSV-fil', 'All figures on the page as a CSV file')}</a>.{' '}
    {
      tr(
        lang,
        'Teckenkodning UTF-8, kommatecken mellan kolumnerna och punkt som decimaltecken. En tom cell betyder att uppgift saknas. Sidan finns också som',
        'UTF-8 encoding, commas between columns and a dot as the decimal point. An empty cell means that no value is available. The page is also available as',
      )
    }{' '}
    <a href={page.mdPath}>{tr(lang, 'textfil (Markdown)', 'a text file (Markdown)')}</a>.
  </p>

  <h2>{tr(lang, 'Använda siffrorna', 'Using the figures')}</h2>
  <p class="body">
    {tr(lang, 'Tabellerna får användas fritt enligt', 'You may use the tables freely under')}{' '}
    <a href={site.dataLicense.url}>{site.dataLicense.name}</a>.{' '}
    {tr(lang, `Ange ${p.credit} som källa.`, `Name ${p.credit} as the source.`)}{p.terms ? ` ${p.terms}` : ''}
  </p>

  <p class="source">
    {tr(lang, 'Källor:', 'Sources:')}{' '}
    {
      p.sources.map((s, i) => (
        <>
          <a href={s.url}>{s.label}</a>
          {i < p.sources.length - 1 ? '; ' : '.'}
        </>
      ))
    }{' '}
    {tr(lang, 'Uppgifterna senast ändrade', 'Data last changed')} {dayMonthYear(updated, lang)}.
  </p>

  <a class="back" href={chartHref}>
    {tr(lang, `Till diagrammet i kapitel ${Number(c.num)}, ${c.navLabel[lang]}`, `Back to the chart in chapter ${Number(c.num)}, ${c.navLabel[lang]}`)}
  </a>

  <nav class="more" aria-labelledby="fler-tabeller">
    <h2 id="fler-tabeller">{tr(lang, 'Fler tabeller', 'More tables')}</h2>
    <ul>
      {
        tablePages
          .filter((x) => x.chapterId !== p.chapterId)
          .map((x) => {
            const other = tablePage(x.chapterId, lang);
            return (
              <li>
                <span class="num">{chapter(x.chapterId).num}</span>
                <a href={other.path}>{other.name}</a>
              </li>
            );
          })
      }
    </ul>
  </nav>
</DataLayout>

<style>
  .more ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .more li {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .more .num {
    color: var(--second);
    font-size: 14px;
    font-weight: 700;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
  }
</style>
