---
// Shared frame for a table page: kicker, headline, summary, "Läs så här", tables,
// download, terms of use, sources, link back to the chart, links to the other
// table pages. Adds Dataset markup.
import DataLayout from '../../layouts/DataLayout.astro';
import DataTableView from './DataTableView.astro';
import { chapter } from '../../lib/chapters';
import { tablePage, tablePages, tablesIndexPath } from '../../lib/dataPages';
import { dataDate } from '../../lib/dataDates';
import { site, absoluteUrl, dayMonthYear } from '../../lib/site';
import type { TablePageContent } from '../../lib/tablePageContent';

interface Props {
  content: TablePageContent;
}

const { content: p } = Astro.props;
const page = tablePage(p.chapterId);
const c = chapter(p.chapterId);
const pageUrl = absoluteUrl(page.path);
// The page changes when its data changes, not on every deploy.
const updated = dataDate(p.dataFiles);

if (p.datasetDescription.length < 50) throw new Error(`${page.path}: dataset description is too short`);
const dataset = {
  '@type': 'Dataset',
  '@id': `${pageUrl}#dataset`,
  name: p.h1,
  description: p.datasetDescription,
  url: pageUrl,
  inLanguage: 'sv-SE',
  keywords: p.keywords,
  license: site.dataLicense.url,
  isAccessibleForFree: true,
  creditText: `${site.name}, efter uppgifter från ${p.credit}`,
  creator: { '@id': `${site.url}#publisher` },
  publisher: { '@id': `${site.url}#publisher` },
  isBasedOn: p.sources.map((s) => s.url),
  dateModified: updated,
  temporalCoverage: p.temporalCoverage,
  spatialCoverage: { '@type': 'Place', name: 'Sverige' },
  variableMeasured: p.variableMeasured,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absoluteUrl(page.csvPath) },
    { '@type': 'DataDownload', encodingFormat: 'text/markdown', contentUrl: absoluteUrl(page.mdPath) },
  ],
};
---

<DataLayout
  title={`${p.shortTitle} | ${site.name}`}
  description={p.description}
  path={page.path}
  updated={updated}
  markdownPath={page.mdPath}
  crumbs={[
    { name: 'Tabeller', path: tablesIndexPath },
    { name: page.name, path: page.path },
  ]}
  citations={p.sources.map((s) => s.url)}
  jsonLdNodes={[dataset]}
>
  <p class="kicker">Tabell · {c.num} {c.navLabel}</p>
  <h1>{p.h1}</h1>
  <p class="lead">{p.lead}</p>

  <div class="note">
    <strong>Läs så här. </strong>
    {p.note}
  </div>

  {
    p.sections.map((s) => (
      <>
        {s.heading && <h2>{s.heading}</h2>}
        {(s.intro || s.collapsed) && (
          <p class="body">
            {[s.intro, s.collapsed ? 'Klicka på en brottstyp för att visa tabellen.' : ''].filter(Boolean).join(' ')}
          </p>
        )}
        {s.collapsed ? (
          <div>
            {s.tables.map((t) => (
              <DataTableView table={t} collapsed />
            ))}
          </div>
        ) : (
          s.tables.map((t) => <DataTableView table={t} />)
        )}
        {s.after && <p class="body">{s.after}</p>}
      </>
    ))
  }

  <h2>Ladda ner</h2>
  <p class="body">
    <a href={page.csvPath} download>Alla siffror på sidan som CSV-fil</a>. Teckenkodning UTF-8, kommatecken mellan
    kolumnerna och punkt som decimaltecken. En tom cell betyder att uppgift saknas. Sidan finns också som <a
      href={page.mdPath}>textfil (Markdown)</a
    >.
  </p>

  <h2>Använda siffrorna</h2>
  <p class="body">
    Tabellerna får användas fritt enligt <a href={site.dataLicense.url}>{site.dataLicense.name}</a>. Ange {p.credit} som
    källa.{p.terms ? ` ${p.terms}` : ''}
  </p>

  <p class="source">
    Källor: {
      p.sources.map((s, i) => (
        <>
          <a href={s.url}>{s.label}</a>
          {i < p.sources.length - 1 ? '; ' : '.'}
        </>
      ))
    } Uppgifterna senast ändrade {dayMonthYear(updated)}.
  </p>

  <a class="back" href={`/#${p.chapterId}`}>Till diagrammet i kapitel {Number(c.num)}, {c.navLabel}</a>

  <nav class="more" aria-labelledby="fler-tabeller">
    <h2 id="fler-tabeller">Fler tabeller</h2>
    <ul>
      {
        tablePages
          .filter((x) => x.chapterId !== p.chapterId)
          .map((x) => (
            <li>
              <span class="num">{chapter(x.chapterId).num}</span>
              <a href={x.path}>{x.name}</a>
            </li>
          ))
      }
    </ul>
  </nav>
</DataLayout>

<style>
  .more ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .more li {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .more .num {
    color: var(--second);
    font-size: 14px;
    font-weight: 700;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
  }
</style>
