---
// One part of the site (for example "Misstänkta för brott") with its chapters.
// Rendered by src/pages/[part]/index.astro and src/pages/en/[part]/index.astro.
import Base from '../layouts/Base.astro';
import ChapterNav from './ChapterNav.astro';
import PageHead from './PageHead.astro';
import Footer from './Footer.astro';
import Kap1 from './chapters/Kap1.astro';
import Kap2 from './chapters/Kap2.astro';
import Kap3 from './chapters/Kap3.astro';
import Kap4 from './chapters/Kap4.astro';
import Kap5 from './chapters/Kap5.astro';
import Kap6 from './chapters/Kap6.astro';
import Kap7 from './chapters/Kap7.astro';
import Kap8 from './chapters/Kap8.astro';
import Kap9 from './chapters/Kap9.astro';
import Kap11 from './chapters/Kap11.astro';
import { chapter } from '../lib/chapters';
import { part, parts, type PartId } from '../lib/parts';
import { partCoverage, partDatasetIds, partMeta, partSourceUrls } from '../lib/partMeta';
import { site, absoluteUrl } from '../lib/site';
import { IN_LANGUAGE, localePath, tr, type Lang } from '../lib/i18n';

interface Props {
  partId: PartId;
  lang: Lang;
}
const { partId, lang } = Astro.props;
const p = part(partId);
const path = p.path[lang];
const COMPONENTS: Record<string, typeof Kap1> = { kap1: Kap1, kap2: Kap2, kap3: Kap3, kap4: Kap4, kap5: Kap5, kap6: Kap6, kap7: Kap7, kap8: Kap8, kap9: Kap9, kap11: Kap11 };
const toc = p.chapters.map((id) => {
  const c = chapter(id);
  return { num: c.num, label: c.kicker[lang], href: `#${id}` };
});

// Search title and description, with the years the part covers (src/lib/partMeta.ts).
const meta = partMeta(partId, lang);
const coverage = partCoverage(partId);
const citations = partSourceUrls(partId, lang);
const pageUrl = absoluteUrl(path);

// Structured data: where the page sits on the site, and what it is. The visible headline stays the part name.
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: absoluteUrl(localePath(lang, '/')) },
    { '@type': 'ListItem', position: 2, name: p.title[lang], item: pageUrl },
  ],
};
// Author and publisher are the site itself, since the person behind it is anonymous.
const articleLd = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: p.title[lang],
  description: meta.description,
  url: pageUrl,
  inLanguage: IN_LANGUAGE[lang],
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  isPartOf: { '@id': `${site.url}#website` },
  author: { '@id': `${site.url}#publisher` },
  publisher: { '@id': `${site.url}#publisher` },
  dateModified: site.updated,
  image: site.shareImage[lang],
  temporalCoverage: `${coverage.first}/${coverage.last}`,
  spatialCoverage: { '@type': 'Place', name: p.country?.[lang] ?? tr(lang, 'Sverige', 'Sweden') },
  // The tables the charts are drawn from (Dataset markup on the table pages), and the original sources.
  isBasedOn: [...partDatasetIds(partId, lang).map((id) => ({ '@id': id })), ...citations],
};
---

<Base
  title={`${meta.title} · ${site.name}`}
  description={meta.description}
  lang={lang}
  path={path}
  citations={citations}
  jsonLdNodes={[breadcrumbLd, articleLd]}
>
  <div class="wrap">
    <ChapterNav current={partId} lang={lang} />
    <PageHead
      kicker={tr(lang, `Del ${p.num} av ${parts.length}`, `Part ${p.num} of ${parts.length}`)}
      title={p.title[lang]}
      intro={p.card[lang]}
      toc={toc}
      path={path}
      lang={lang}
    />
    <main>
      {
        p.chapters.map((id) => {
          const Component = COMPONENTS[id];
          if (!Component) throw new Error(`No component for chapter ${id}`);
          return <Component lang={lang} />;
        })
      }
    </main>
    <Footer lang={lang} path={path} />
  </div>
</Base>
